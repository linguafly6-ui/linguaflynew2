{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "linguaflynew2",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": ".open-next/worker.js",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog",
      "database_id": "476f34d4-5622-4a56-923e-c4fb571578c2"
    },
    {
      "binding": "COURSE_DB",
      "database_name": "linguafly-learning",
      "database_id": "0982f4a2-ce92-410a-9e72-e5a34c461612"
    }
  ],
  "r2_buckets": [
    {
      "binding": "LINGUAFLY_MEDIA",
      "bucket_name": "linguafly-media"
    }
  ],
  "ai": { "binding": "AI" },
  "images": { "binding": "IMAGES" },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "linguaflyapp1",
      "environment": "production"
    }
  ],
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://linguafly.app"
  }
}
