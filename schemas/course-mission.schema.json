{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LinguaFly Course Mission v1.2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contentVersion",
    "course",
    "unit",
    "mission",
    "sections"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.2.0"
    },
    "contentVersion": {
      "type": "integer",
      "minimum": 1
    },
    "course": {
      "type": "object",
      "required": [
        "courseId",
        "level",
        "language"
      ],
      "properties": {
        "courseId": {
          "$ref": "#/$defs/id"
        },
        "level": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]*$"
        },
        "language": {
          "const": "en-GB"
        }
      },
      "additionalProperties": false
    },
    "unit": {
      "type": "object",
      "required": [
        "unitId",
        "courseId",
        "position",
        "title"
      ],
      "properties": {
        "unitId": {
          "$ref": "#/$defs/id"
        },
        "courseId": {
          "$ref": "#/$defs/id"
        },
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "$ref": "#/$defs/nonEmpty"
        }
      },
      "additionalProperties": false
    },
    "mission": {
      "type": "object",
      "required": [
        "missionId",
        "unitId",
        "position",
        "title"
      ],
      "properties": {
        "missionId": {
          "$ref": "#/$defs/id"
        },
        "unitId": {
          "$ref": "#/$defs/id"
        },
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "$ref": "#/$defs/nonEmpty"
        }
      },
      "additionalProperties": false
    },
    "sections": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "prefixItems": [
        {
          "$ref": "#/$defs/explore"
        },
        {
          "$ref": "#/$defs/practice"
        },
        {
          "$ref": "#/$defs/grammar"
        },
        {
          "$ref": "#/$defs/pronunciation"
        },
        {
          "$ref": "#/$defs/reading"
        },
        {
          "$ref": "#/$defs/writing"
        },
        {
          "$ref": "#/$defs/speaking"
        },
        {
          "$ref": "#/$defs/listening"
        }
      ],
      "items": false
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1
    },
    "evaluation": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "exact",
            "single_choice",
            "normalised_text",
            "rubric",
            "assisted_analysis"
          ]
        }
      }
    },
    "itemBase": {
      "type": "object",
      "required": [
        "itemId",
        "position"
      ],
      "properties": {
        "itemId": {
          "$ref": "#/$defs/id"
        },
        "position": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "sectionBase": {
      "type": "object",
      "required": [
        "sectionId",
        "sectionKey",
        "position",
        "exercise"
      ],
      "properties": {
        "sectionId": {
          "$ref": "#/$defs/id"
        },
        "position": {
          "type": "integer",
          "minimum": 1
        },
        "exercise": {
          "type": "object",
          "required": [
            "exerciseId",
            "type",
            "items"
          ],
          "properties": {
            "exerciseId": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "type": "string"
            },
            "items": {
              "type": "array"
            }
          }
        }
      }
    },
    "explore": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "properties": {
            "sectionKey": {
              "const": "explore"
            },
            "position": {
              "const": 1
            },
            "exercise": {
              "properties": {
                "type": {
                  "const": "vocabulary_pairs"
                },
                "items": {
                  "type": "array",
                  "minItems": 10,
                  "maxItems": 50,
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/itemBase"
                      }
                    ],
                    "required": [
                      "english",
                      "spanish"
                    ],
                    "properties": {
                      "english": {
                        "$ref": "#/$defs/nonEmpty"
                      },
                      "spanish": {
                        "$ref": "#/$defs/nonEmpty"
                      },
                      "audio": {
                        "type": "string"
                      },
                      "pronunciationGuide": {
                        "type": "string"
                      }
                    }
                  }
                },
                "theory": {
                  "type": "object",
                  "required": [
                    "title",
                    "explanation",
                    "patterns",
                    "tip"
                  ],
                  "properties": {
                    "title": {
                      "$ref": "#/$defs/nonEmpty"
                    },
                    "explanation": {
                      "$ref": "#/$defs/nonEmpty"
                    },
                    "tip": {
                      "$ref": "#/$defs/nonEmpty"
                    },
                    "patterns": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "label",
                          "pattern",
                          "examples"
                        ],
                        "properties": {
                          "label": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "pattern": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "examples": {
                            "type": "array",
                            "minItems": 1,
                            "items": {
                              "$ref": "#/$defs/nonEmpty"
                            }
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                },
                "lesson": {
                  "type": "object",
                  "required": [
                    "phrases",
                    "grammar",
                    "reading",
                    "writing",
                    "speaking",
                    "listening"
                  ],
                  "properties": {
                    "phrases": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "english",
                          "spanish"
                        ],
                        "properties": {
                          "english": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "spanish": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "note": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "prompt": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "promptSpanish": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "pronunciationGuide": {
                            "type": "string"
                          },
                          "audio": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "grammar": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "english",
                          "spanish"
                        ],
                        "properties": {
                          "english": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "spanish": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "note": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "prompt": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "promptSpanish": {
                            "$ref": "#/$defs/nonEmpty"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "reading": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "english",
                          "spanish"
                        ],
                        "properties": {
                          "english": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "spanish": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "note": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "prompt": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "promptSpanish": {
                            "$ref": "#/$defs/nonEmpty"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "writing": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "english",
                          "spanish"
                        ],
                        "properties": {
                          "english": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "spanish": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "note": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "prompt": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "promptSpanish": {
                            "$ref": "#/$defs/nonEmpty"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "speaking": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "english",
                          "spanish"
                        ],
                        "properties": {
                          "english": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "spanish": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "note": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "prompt": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "promptSpanish": {
                            "$ref": "#/$defs/nonEmpty"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "listening": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "english",
                          "spanish"
                        ],
                        "properties": {
                          "english": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "spanish": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "note": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "prompt": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "promptSpanish": {
                            "$ref": "#/$defs/nonEmpty"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "examples": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "english",
                          "spanish"
                        ],
                        "properties": {
                          "english": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "spanish": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "note": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "prompt": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "promptSpanish": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "pronunciationGuide": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "communication": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "english",
                          "spanish"
                        ],
                        "properties": {
                          "english": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "spanish": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "note": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "prompt": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "promptSpanish": {
                            "$ref": "#/$defs/nonEmpty"
                          },
                          "pronunciationGuide": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              },
              "required": [
                "theory"
              ]
            }
          }
        }
      ]
    },
    "practice": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "properties": {
            "sectionKey": {
              "const": "practice"
            },
            "position": {
              "const": 2
            },
            "exercise": {
              "properties": {
                "type": {
                  "const": "mixed_practice"
                },
                "items": {
                  "type": "array",
                  "minItems": 10,
                  "maxItems": 20,
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/itemBase"
                      }
                    ],
                    "required": [
                      "taskType",
                      "prompt",
                      "evaluation"
                    ],
                    "properties": {
                      "taskType": {
                        "$ref": "#/$defs/nonEmpty"
                      },
                      "prompt": {
                        "$ref": "#/$defs/nonEmpty"
                      },
                      "evaluation": {
                        "$ref": "#/$defs/evaluation"
                      },
                      "options": {
                        "type": "array",
                        "minItems": 2,
                        "items": {
                          "$ref": "#/$defs/nonEmpty"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "grammar": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "properties": {
            "sectionKey": {
              "const": "grammar"
            },
            "position": {
              "const": 3
            },
            "exercise": {
              "properties": {
                "type": {
                  "const": "grammar"
                },
                "items": {
                  "type": "array",
                  "minItems": 10,
                  "maxItems": 10,
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/itemBase"
                      }
                    ],
                    "required": [
                      "prompt",
                      "evaluation"
                    ],
                    "properties": {
                      "prompt": {
                        "$ref": "#/$defs/nonEmpty"
                      },
                      "evaluation": {
                        "$ref": "#/$defs/evaluation"
                      },
                      "options": {
                        "type": "array",
                        "minItems": 2,
                        "items": {
                          "$ref": "#/$defs/nonEmpty"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "pronunciation": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "properties": {
            "sectionKey": {
              "const": "pronunciation"
            },
            "position": {
              "const": 4
            },
            "exercise": {
              "properties": {
                "type": {
                  "const": "pronunciation_cards"
                },
                "items": {
                  "type": "array",
                  "minItems": 10,
                  "maxItems": 10,
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/itemBase"
                      }
                    ],
                    "required": [
                      "word",
                      "translation",
                      "pronunciationGuide",
                      "audio"
                    ],
                    "properties": {
                      "word": {
                        "$ref": "#/$defs/nonEmpty"
                      },
                      "translation": {
                        "$ref": "#/$defs/nonEmpty"
                      },
                      "pronunciationGuide": {
                        "$ref": "#/$defs/nonEmpty"
                      },
                      "audio": {
                        "$ref": "#/$defs/nonEmpty"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "reading": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "properties": {
            "sectionKey": {
              "const": "reading"
            },
            "position": {
              "const": 5
            },
            "exercise": {
              "required": [
                "content"
              ],
              "properties": {
                "type": {
                  "const": "reading_comprehension"
                },
                "content": {
                  "type": "object",
                  "required": [
                    "passageId",
                    "passage"
                  ],
                  "properties": {
                    "passageId": {
                      "$ref": "#/$defs/id"
                    },
                    "passage": {
                      "$ref": "#/$defs/nonEmpty"
                    }
                  }
                },
                "items": {
                  "type": "array",
                  "minItems": 10,
                  "maxItems": 10,
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/itemBase"
                      }
                    ],
                    "required": [
                      "prompt",
                      "evaluation"
                    ],
                    "properties": {
                      "prompt": {
                        "$ref": "#/$defs/nonEmpty"
                      },
                      "evaluation": {
                        "$ref": "#/$defs/evaluation"
                      },
                      "options": {
                        "type": "array",
                        "minItems": 2,
                        "items": {
                          "$ref": "#/$defs/nonEmpty"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "writing": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "properties": {
            "sectionKey": {
              "const": "writing"
            },
            "position": {
              "const": 6
            },
            "exercise": {
              "properties": {
                "type": {
                  "const": "dictation"
                },
                "items": {
                  "type": "array",
                  "minItems": 10,
                  "maxItems": 10,
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/itemBase"
                      }
                    ],
                    "required": [
                      "audio",
                      "audioLocale",
                      "kind",
                      "repeatCount",
                      "segments",
                      "expectedAnswer",
                      "evaluation"
                    ],
                    "properties": {
                      "audio": {
                        "$ref": "#/$defs/nonEmpty"
                      },
                      "expectedAnswer": {
                        "$ref": "#/$defs/nonEmpty"
                      },
                      "evaluation": {
                        "$ref": "#/$defs/evaluation"
                      },
                      "audioLocale": {
                        "const": "en-GB"
                      },
                      "repeatCount": {
                        "const": 3
                      },
                      "kind": {
                        "enum": [
                          "sentence",
                          "passage"
                        ]
                      },
                      "segments": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 30,
                        "items": {
                          "type": "object",
                          "required": [
                            "segmentId",
                            "text"
                          ],
                          "properties": {
                            "segmentId": {
                              "$ref": "#/$defs/id"
                            },
                            "text": {
                              "$ref": "#/$defs/nonEmpty"
                            }
                          },
                          "additionalProperties": false
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "speaking": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "properties": {
            "sectionKey": {
              "const": "speaking"
            },
            "position": {
              "const": 7
            },
            "exercise": {
              "properties": {
                "type": {
                  "const": "speaking_prompts"
                },
                "items": {
                  "type": "array",
                  "minItems": 10,
                  "maxItems": 10,
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/itemBase"
                      }
                    ],
                    "required": [
                      "prompt",
                      "modelAnswer",
                      "evaluation"
                    ],
                    "properties": {
                      "prompt": {
                        "$ref": "#/$defs/nonEmpty"
                      },
                      "modelAnswer": {
                        "$ref": "#/$defs/nonEmpty"
                      },
                      "evaluation": {
                        "type": "object",
                        "required": [
                          "type",
                          "transcriptionSeparateFromPronunciation"
                        ],
                        "properties": {
                          "type": {
                            "enum": [
                              "transcription_feedback",
                              "pronunciation_analysis",
                              "rubric"
                            ]
                          },
                          "transcriptionSeparateFromPronunciation": {
                            "const": true
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "listening": {
      "allOf": [
        {
          "$ref": "#/$defs/sectionBase"
        },
        {
          "properties": {
            "sectionKey": {
              "const": "listening"
            },
            "position": {
              "const": 8
            },
            "exercise": {
              "required": [
                "content"
              ],
              "properties": {
                "type": {
                  "const": "listening_gap_fill"
                },
                "content": {
                  "type": "object",
                  "required": [
                    "audio",
                    "audioLocale",
                    "transcriptTemplate",
                    "wordBank",
                    "interaction"
                  ],
                  "properties": {
                    "audio": {
                      "$ref": "#/$defs/nonEmpty"
                    },
                    "transcriptTemplate": {
                      "$ref": "#/$defs/nonEmpty"
                    },
                    "wordBank": {
                      "type": "array",
                      "minItems": 10,
                      "maxItems": 10,
                      "items": {
                        "type": "object",
                        "required": [
                          "wordId",
                          "word"
                        ],
                        "properties": {
                          "wordId": {
                            "$ref": "#/$defs/id"
                          },
                          "word": {
                            "$ref": "#/$defs/nonEmpty"
                          }
                        }
                      },
                      "uniqueItems": true
                    },
                    "audioLocale": {
                      "const": "en-GB"
                    },
                    "interaction": {
                      "const": "select_place_move_replace"
                    },
                    "audioTranscript": {
                      "$ref": "#/$defs/nonEmpty"
                    }
                  }
                },
                "items": {
                  "type": "array",
                  "minItems": 10,
                  "maxItems": 10,
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/$defs/itemBase"
                      }
                    ],
                    "required": [
                      "gapToken",
                      "expectedWordId"
                    ],
                    "properties": {
                      "gapToken": {
                        "type": "string",
                        "pattern": "^\\[\\[gap-(0[1-9]|10)\\]\\]$"
                      },
                      "expectedWordId": {
                        "$ref": "#/$defs/id"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  }
}
