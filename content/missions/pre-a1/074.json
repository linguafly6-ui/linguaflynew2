          "title": "En el mercado",
          "explanation": "Usa «I buy…» para decir qué compras y «How much is it?» para preguntar el precio.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "I buy fruit.",
              "examples": [
                "I buy fruit.",
                "The seller has a basket.",
                "How much is the apple?"
              ]
            },
            {
              "label": "Uso",
              "pattern": "Lee la frase y usa el modelo para hablar de una situación parecida.",
              "examples": [
                "I buy fruit.",
                "The seller has a basket.",
                "How much is the apple?"
              ]
            }
          ],
          "tip": "Lee la frase completa, escucha el modelo y repítelo en voz alta."
