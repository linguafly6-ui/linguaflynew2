        "theory": {
          "title": "There is / There are + preposiciones (repaso)",
          "explanation": "Repasamos «There is» para una cosa y «There are» para varias. Para indicar la posición usamos preposiciones como «in», «on», «under» y «next to». Observa primero cuántos objetos hay y dónde están.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "There is a sofa. The chair is next to the table.",
              "examples": [
                "There is a sofa. The chair is next to the table."
              ]
            },
            {
              "label": "Uso",
              "pattern": "Completa una descripción de una casa eligiendo singular/plural y la preposición adecuada.",
              "examples": [
                "The chair is next to the table."
              ]
            }
          ],
          "tip": "Observa el ejemplo y repite las frases en voz alta."
        }
      }
