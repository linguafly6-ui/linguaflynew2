        "theory": {
          "title": "It is… / It has got… / It can… (descripción inicial)",
          "explanation": "Para describir un animal podemos decir «It is…» y añadir una característica: big, small, fast o slow. También podemos reconocer «It has got…» para nombrar una parte del cuerpo y «It can…» para una capacidad: «It can run».",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "It is big. It has got a tail. It can run.",
              "examples": [
                "It is big. It has got a tail. It can run."
              ]
            },
            {
              "label": "Uso",
              "pattern": "Lee tres pistas sobre un animal y elige la descripción que coincide.",
              "examples": [
                "It is big."
              ]
            }
          ],
          "tip": "Observa el ejemplo y repite las frases en voz alta."
        }
      }
    },
