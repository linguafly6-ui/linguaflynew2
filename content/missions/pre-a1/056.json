        "theory": {
          "title": "My name is… / I'm… years old",
          "explanation": "Para decir nuestro nombre usamos «My name is…». Para decir la edad usamos «I’m… years old». Podemos unir las dos frases para presentarnos: «My name is Sam. I’m six years old».",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "My name is Sam. I’m six years old.",
              "examples": [
                "My name is Sam. I’m six years old."
              ]
            },
            {
              "label": "Uso",
              "pattern": "Completa una presentación con un nombre y una edad.",
              "examples": [
                "My name is Sam."
              ]
            }
          ],
          "tip": "Observa el ejemplo y repite las frases en voz alta."
        }
      }
