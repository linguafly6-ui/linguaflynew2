        "theory": {
          "title": "Lugares de la ciudad",
          "explanation": "Usa «There is a…» para un lugar y «There are…» para varios.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "There is a school.",
              "examples": [
                "There is a school.",
                "There is a park.",
                "There are two shops."
              ]
            },
            {
              "label": "Práctica",
              "pattern": "Lee la frase, escucha el modelo y crea una frase parecida.",
              "examples": [
                "There is a school.",
                "There is a park.",
                "There are two shops."
              ]
            }
          ],
          "tip": "Escucha y repite. Fíjate en el orden de las palabras y usa el modelo para hablar."
        }
      }
