        "theory": {
          "title": "There is / There are + preposiciones",
          "explanation": "«There is» significa «hay» cuando hablamos de una cosa; «There are» se usa con varias cosas. Para decir dónde está un objeto, añadimos una preposición: «in» (dentro), «on» (sobre), «under» (debajo) o «next to» (al lado).",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "There is a bed. The book is on the table.",
              "examples": [
                "There is a bed. The book is on the table.",
                "The book is on the table."
              ]
            },
            {
              "label": "Práctica",
              "pattern": "Elige is o are y después señala la posición correcta del objeto.",
              "examples": [
                "The book is on the table."
              ]
            }
          ],
          "tip": "Lee el ejemplo y observa cómo se usa el vocabulario en una frase."
        }
      }
    },
