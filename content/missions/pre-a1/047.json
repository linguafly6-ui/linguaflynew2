        "theory": {
          "title": "Objetos y lugares de la casa",
          "explanation": "Usa «There is» con una cosa y «There are» con varias. Añade «in», «on», «under» o «next to» para indicar dónde está algo.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "There is a bed.",
              "examples": [
                "There is a bed.",
                "There are two chairs.",
                "The book is on the table."
              ]
            },
            {
              "label": "Práctica",
              "pattern": "Lee la frase, escucha el modelo y crea una frase parecida.",
              "examples": [
                "There is a bed.",
                "There are two chairs.",
                "The book is on the table."
              ]
            }
          ],
          "tip": "Escucha y repite. Fíjate en el orden de las palabras y usa el modelo para hablar."
        }
      }
