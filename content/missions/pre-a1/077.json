          "title": "En el cine",
          "explanation": "Usa «We go to the cinema» y «We watch a film» para hablar de una salida al cine.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "We go to the cinema.",
              "examples": [
                "We go to the cinema.",
                "We watch a film.",
                "We eat popcorn."
              ]
            },
            {
              "label": "Uso",
              "pattern": "Lee la frase y usa el modelo para hablar de una situación parecida.",
              "examples": [
                "We go to the cinema.",
                "We watch a film.",
                "We eat popcorn."
              ]
            }
          ],
          "tip": "Lee la frase completa, escucha el modelo y repítelo en voz alta."
        }
