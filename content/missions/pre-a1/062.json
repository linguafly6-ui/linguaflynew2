        "theory": {
          "title": "Whose…? + adjetivo posesivo",
          "explanation": "Usamos «Whose…?» para preguntar de quién es un objeto. Podemos responder «It’s my…», «It’s your…», «It’s his…» o «It’s her…». El posesivo va delante del nombre del objeto.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "Whose pencil is it? It's his pencil.",
              "examples": [
                "Whose pencil is it? It's his pencil."
              ]
            },
            {
              "label": "Uso",
              "pattern": "Completa un diálogo sobre objetos perdidos con la pregunta y el posesivo adecuados.",
              "examples": [
                "It's her pencil."
              ]
            }
          ],
          "tip": "Observa el ejemplo y repite las frases en voz alta."
        }
