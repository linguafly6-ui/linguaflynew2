        "theory": {
          "title": "Repaso integrado: TO BE, can, likes, there is/are y preposiciones",
          "explanation": "Esta misión reúne estructuras que ya has practicado. Usa «It is…» para describir, «It can…» para capacidades, «I like…» para gustos, «There is / There are» para decir qué hay y las preposiciones para indicar dónde está algo. No necesitas aprender una regla nueva: combina modelos conocidos.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "It is a fox. It can run. There is a tree. The ball is under the tree.",
              "examples": [
                "It is a fox. It can run. There is a tree. The ball is under the tree."
              ]
            },
            {
              "label": "Uso",
              "pattern": "Lee cada pequeña situación y combina la estructura que ya conoces.",
              "examples": [
                "There is a tree."
              ]
            }
          ],
          "tip": "Observa el ejemplo y repite las frases en voz alta."
        }
