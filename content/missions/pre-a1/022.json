        "exerciseId": "english-pre-a1-m022-grammar-ex01",
        "type": "grammar",
        "theory": {
          "focus": "Peticiones corteses: please / thank you",
          "explanation": "En un pedido sencillo podemos decir el nombre de la bebida o comida y añadir «please» para pedirla con educación. Cuando recibimos algo, podemos responder «thank you». En esta misión practicamos estas expresiones como fórmulas completas.",
          "model": "Water, please. Thank you.",
          "practice": "Construye un intercambio corto entre una persona que pide y otra que sirve."
        },
        "items": [
          {
            "itemId": "english-pre-a1-m022-grammar-ex01-i01",
            "position": 1,
            "prompt": "You want water. What do you say?",
            "evaluation": {
              "type": "single_choice"
            },
            "options": [
              "Water, please.",
              "Water goodbye.",
              "Please thank you water."
            ]
          },
          {
