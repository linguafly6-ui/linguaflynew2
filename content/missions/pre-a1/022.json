    {
      "sectionId": "english-pre-a1-m022-grammar",
      "sectionKey": "grammar",
      "position": 3,
      "exercise": {
        "exerciseId": "english-pre-a1-m022-grammar-ex01",
        "type": "grammar",
        "theory": {
          "focus": "Peticiones corteses: please / thank you",
          "explanation": "En un pedido sencillo podemos decir el nombre de la bebida o comida y añadir «please» para pedirla con educación. Cuando recibimos algo, podemos responder «thank you». En esta misión practicamos estas expresiones como fórmulas completas.",
          "model": "Water, please. Thank you.",
          "practice": "Construye un intercambio corto entre una persona que pide y otra que sirve."
        },
        "items": [
          {
            "itemId": "english-pre-a1-m022-grammar-ex01-i01",
            "position": 1,
            "prompt": "You want water. What do you say?",
            "evaluation": {
              "type": "single_choice"
            },
            "options": [
              "Water, please.",
              "Water goodbye.",
              "Please water thank."
            ]
          },
          {
            "itemId": "english-pre-a1-m022-grammar-ex01-i02",
            "position": 2,
            "prompt": "The worker gives you tea. What do you say?",
            "evaluation": {
              "type": "single_choice"
            },
            "options": [
              "Thank you.",
              "Please tea.",
              "Good night tea."
            ]
          },
          {
            "itemId": "english-pre-a1-m022-grammar-ex01-i03",
            "position": 3,
            "prompt": "Choose the polite request.",
            "evaluation": {
              "type": "single_choice"
            },
            "options": [
              "A sandwich, please.",
              "A sandwich now!",
              "Thank you sandwich."
            ]
          },
          {
            "itemId": "english-pre-a1-m022-grammar-ex01-i04",
            "position": 4,
            "prompt": "Complete: “Juice, please.” “___”",
            "evaluation": {
              "type": "single_choice"
            },
            "options": [
              "Here you are.",
              "Please juice.",
              "Good night."
            ]
          },
          {
            "itemId": "english-pre-a1-m022-grammar-ex01-i05",
            "position": 5,
            "prompt": "You want coffee. What do you say?",
            "evaluation": {
              "type": "single_choice"
            },
            "options": [
              "Coffee, please.",
              "Coffee goodbye.",
              "Please coffee thank."
            ]
          },
          {
            "itemId": "english-pre-a1-m022-grammar-ex01-i06",
            "position": 6,
            "prompt": "Your friend gives you a drink. What do you say?",
            "evaluation": {
              "type": "single_choice"
            },
            "options": [
              "Thank you.",
              "Goodbye drink.",
