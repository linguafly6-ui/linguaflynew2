        "theory": {
          "title": "Sentimientos y necesidades",
          "explanation": "Usa «I am…» para hablar de cómo te sientes. Con «he» y «she» usamos «is»: «She is happy».",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "I am happy.",
              "examples": [
                "I am happy.",
                "She is tired.",
                "He is thirsty."
              ]
            },
            {
              "label": "Uso",
              "pattern": "Escucha, observa el ejemplo y crea una frase parecida.",
              "examples": [
                "I am happy.",
                "She is tired.",
                "He is thirsty."
              ]
            }
          ],
          "tip": "Escucha y repite. Fíjate en el orden de las palabras y practica con el modelo."
        }
      }
