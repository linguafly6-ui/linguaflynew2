        "theory": {
          "title": "In the garden: Plants",
          "explanation": "Usa «There is…» para describir el jardín y verbos como «plant», «water» y «grow» para hablar de las plantas.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "There is a plant in the pot.",
              "examples": [
                "There is a plant in the pot.",
                "The seed grows in the soil.",
                "I water the rose."
              ]
            },
            {
              "label": "Uso",
              "pattern": "Lee el modelo y cambia una palabra para crear una frase propia.",
              "examples": [
                "There is a plant in the pot.",
                "The seed grows in the soil.",
                "I water the rose."
              ]
            }
          ],
          "tip": "Escucha la frase, repítela y cambia una palabra para crear un ejemplo propio."
        }
