        "theory": {
          "title": "Imperativos: Stop / Go",
          "explanation": "«Stop» significa parar y «Go» significa avanzar o ir. Son instrucciones cortas y el verbo aparece al principio. Para esta misión, recuerda: Stop at red. Wait with an adult. Go at green when it is safe.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "Stop at red. Go at green.",
              "examples": [
                "Stop at red. Go at green.",
                "Stop at red."
              ]
            },
            {
              "label": "Práctica",
              "pattern": "Observa el color del semáforo y elige la instrucción adecuada. Sigue siempre las indicaciones de un adulto.",
              "examples": [
                "Stop at red."
              ]
            }
          ],
          "tip": "Lee el ejemplo y observa cómo se usa el vocabulario en una frase."
        }
      }
