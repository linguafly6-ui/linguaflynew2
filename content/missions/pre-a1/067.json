        "theory": {
          "title": "I'm wearing… / It's…",
          "explanation": "Usamos «I’m wearing…» para decir qué ropa llevamos puesta. Después ponemos la prenda: «I’m wearing a hat». Para decir el color usamos «It’s…»: «It’s blue». El color va antes del nombre cuando describimos una prenda: «a blue hat».",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "I'm wearing a blue hat. It's blue.",
              "examples": [
                "I'm wearing a blue hat. It's blue."
              ]
            },
            {
              "label": "Uso",
              "pattern": "Mira la ropa de la persona y completa la descripción con prenda y color.",
              "examples": [
                "I'm wearing a blue hat."
              ]
            }
          ],
          "tip": "Observa el ejemplo y repite las frases en voz alta."
        }
      }
    },
