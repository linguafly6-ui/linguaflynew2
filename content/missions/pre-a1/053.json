        ],
        "theory": {
          "title": "Artículos a / an; plural regular -s",
          "explanation": "Usamos «a» antes de un nombre singular que empieza con sonido consonántico: «a book». Usamos «an» antes de un sonido vocálico: «an apple». Para formar muchos plurales sencillos añadimos -s: «book / books», «apple / apples».",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "A book. An apple. Two books.",
              "examples": [
                "A book. An apple. Two books."
              ]
            },
            {
              "label": "Uso",
              "pattern": "Elige a o an para una sola cosa y reconoce la forma plural cuando hay dos o muchas.",
              "examples": [
                "Two books."
              ]
            }
          ],
          "tip": "Observa el ejemplo y repite las frases en voz alta."
        }
      }
