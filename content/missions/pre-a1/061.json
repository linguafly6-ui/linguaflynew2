        "theory": {
          "title": "Posesivos my / your / his / her",
          "explanation": "Los posesivos van delante del objeto y muestran a quién pertenece: «my bag», «your book», «his pencil», «her toy».",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "This is my bag.",
              "examples": [
                "This is my bag.",
                "Is this your book?",
                "It is her toy."
              ]
            },
            {
              "label": "Uso",
              "pattern": "Escucha el ejemplo y construye una frase parecida.",
              "examples": [
                "This is my bag.",
                "Is this your book?",
                "It is her toy."
              ]
            }
          ],
          "tip": "Escucha y repite. Fíjate en quién tiene el objeto o en la información que quieres preguntar."
        }
      }
