      "position": 3,
      "exercise": {
        "exerciseId": "english-pre-a1-m027-grammar-ex01",
        "type": "grammar",
        "theory": {
          "focus": "It is a…; adjetivo + animal",
          "explanation": "Para nombrar y describir un animal, usamos «It is a…» y podemos añadir un adjetivo antes del nombre: «a big elephant». El adjetivo va antes del animal.",
          "model": "It is a big elephant.",
          "practice": "Elige el adjetivo y el animal que coinciden con la descripción."
        },
        "items": [
          {
            "itemId": "english-pre-a1-m027-grammar-ex01-i01",
            "position": 1,
            "prompt": "Choose the correct word order.",
            "evaluation": {
              "type": "single_choice"
            },
            "options": [
              "a big elephant",
              "an elephant big",
              "big a elephant"
            ]
          },
          {
            "itemId": "english-pre-a1-m027-grammar-ex01-i02",
            "position": 2,
            "prompt": "Complete: It is ___ lion.",
            "evaluation": {
              "type": "single_choice"
            },
            "options": [
              "a",
              "an",
              "are"
            ]
