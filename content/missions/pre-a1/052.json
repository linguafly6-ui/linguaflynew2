        "theory": {
          "title": "Demostrativos: this / that / these / those",
          "explanation": "Usamos «this» para una cosa que está cerca y «that» para una cosa que está más lejos. Para varias cosas usamos «these» si están cerca y «those» si están lejos. Podemos acompañarlos con «is» en singular y «are» en plural.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "This is a book. Those are books.",
              "examples": [
                "This is a book. Those are books."
              ]
            },
            {
              "label": "Uso",
              "pattern": "Observa la distancia y si hay uno o varios objetos. Elige el demostrativo correcto.",
              "examples": [
                "This is a book."
              ]
            }
          ],
          "tip": "Observa el ejemplo y repite las frases en voz alta."
        }
      }
    },
