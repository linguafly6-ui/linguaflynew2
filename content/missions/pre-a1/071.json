        "theory": {
          "title": "En la estación de tren",
          "explanation": "Usa «The train is…» para describir dónde está el tren y «The train arrives/departs…» para hablar de horarios.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "The train is at platform 2.",
              "examples": [
                "The train is at platform 2.",
                "The arrival time is nine fifteen.",
                "The departure time is nine thirty."
              ]
            },
            {
              "label": "Uso",
              "pattern": "Lee la frase y usa el modelo para hablar de una situación parecida.",
              "examples": [
                "The train is at platform 2.",
                "The arrival time is nine fifteen.",
                "The departure time is nine thirty."
              ]
            }
          ],
          "tip": "Lee la frase completa, escucha el modelo y repítelo en voz alta."
        }
