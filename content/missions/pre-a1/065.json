        "theory": {
          "title": "I like / I don't like / Do you like…?",
          "explanation": "Usamos «I like…» para decir que algo nos gusta y «I don’t like…» para decir que no nos gusta. Para preguntar a otra persona usamos «Do you like…?». Podemos responder «Yes, I do» o «No, I don’t».",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "Do you like apples? Yes, I do. / No, I don't.",
              "examples": [
                "Do you like apples? Yes, I do. / No, I don't."
              ]
            },
            {
              "label": "Uso",
              "pattern": "Pregunta sobre un alimento y selecciona una respuesta de gusto.",
              "examples": [
                "I like apples."
              ]
            }
          ],
          "tip": "Observa el ejemplo y repite las frases en voz alta."
        }
