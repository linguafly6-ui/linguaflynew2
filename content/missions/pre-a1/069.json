        "theory": {
          "title": "Preguntas con Wh-",
          "explanation": "Usa «what» para preguntar por cosas, «who» por personas y «where» por lugares. «When» pregunta por el momento y «how» por la manera.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "What is it?",
              "examples": [
                "What is it?",
                "Who is she?",
                "Where is the book?"
              ]
            },
            {
              "label": "Uso",
              "pattern": "Escucha el ejemplo y construye una frase parecida.",
              "examples": [
                "What is it?",
                "Who is she?",
                "Where is the book?"
              ]
            }
          ],
          "tip": "Escucha y repite. Fíjate en quién tiene el objeto o en la información que quieres preguntar."
