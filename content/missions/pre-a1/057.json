        "theory": {
          "title": "Saludos según el momento del día y despedidas",
          "explanation": "Usamos «Good morning» por la mañana para saludar. «Hello» y «Hi» son saludos generales. Para despedirnos podemos decir «Goodbye» o «See you». «Please» se añade a una petición cortés.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "Good morning! Goodbye. See you!",
              "examples": [
                "Good morning! Goodbye. See you!"
              ]
            },
            {
              "label": "Uso",
              "pattern": "Elige el saludo o la despedida que encaja con la situación.",
              "examples": [
                "Good morning!"
              ]
            }
          ],
          "tip": "Observa el ejemplo y repite las frases en voz alta."
        }
