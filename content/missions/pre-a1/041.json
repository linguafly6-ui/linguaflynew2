        "theory": {
          "title": "Deportes y movimiento",
          "explanation": "Usa «I play + deporte» para decir qué deporte practicas y «I can + verbo» para hablar de lo que sabes hacer.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "I play football.",
              "examples": [
                "I play football.",
                "I can swim.",
                "I can ride a bike."
              ]
            },
            {
              "label": "Práctica",
              "pattern": "Lee la frase, escucha el modelo y crea una frase parecida.",
              "examples": [
                "I play football.",
                "I can swim.",
                "I can ride a bike."
              ]
            }
          ],
          "tip": "Escucha y repite. Fíjate en el orden de las palabras y usa el modelo para hablar."
        }
