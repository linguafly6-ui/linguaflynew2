          }
        ],
        "theory": {
          "title": "Have got afirmativo: I've got / you've got / he's got / she's got",
          "explanation": "Usamos «have got» para decir que tenemos algo. Las formas cortas son «I’ve got» y «you’ve got». Con «he» y «she» usamos «has got», que se contrae como «he’s got» y «she’s got». Después ponemos el objeto: «I’ve got a book».",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "I've got a book. She's got a toy.",
              "examples": [
                "I've got a book. She's got a toy."
              ]
            },
            {
              "label": "Uso",
              "pattern": "Elige have got o has got según la persona que tiene el objeto.",
              "examples": [
                "I've got a book."
              ]
            }
          ],
          "tip": "Observa el ejemplo y repite las frases en voz alta."
        }
      }
    },
