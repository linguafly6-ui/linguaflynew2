        "theory": {
          "title": "How much? / buy… (fórmulas de compra)",
          "explanation": "En una tienda podemos preguntar «How much?» para saber el precio. La palabra «buy» significa comprar. En esta misión usamos «How much?» como pregunta fija y respondemos con una cantidad o un precio muy sencillo.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "How much? One coin, please.",
              "examples": [
                "How much? One coin, please.",
                "How much?"
              ]
            },
            {
              "label": "Práctica",
              "pattern": "Completa un intercambio breve entre el cliente y la persona de la tienda.",
              "examples": [
                "How much?"
              ]
            }
          ],
          "tip": "Lee el ejemplo y observa cómo se usa el vocabulario en una frase."
        }
