        "theory": {
          "title": "Medios de transporte",
          "explanation": "Usa «It is a…» para identificar un transporte y «go by + transporte» para decir cómo viajas.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "It is a bus.",
              "examples": [
                "It is a bus.",
                "I go by train.",
                "The boat is on the river."
              ]
            },
            {
              "label": "Práctica",
              "pattern": "Lee la frase, escucha el modelo y crea una frase parecida.",
              "examples": [
                "It is a bus.",
                "I go by train.",
                "The boat is on the river."
              ]
            }
          ],
          "tip": "Escucha y repite. Fíjate en el orden de las palabras y usa el modelo para hablar."
        }
      }
