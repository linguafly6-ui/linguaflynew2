        "theory": {
          "title": "Instrucciones y deportes",
          "explanation": "Usa «Start!» para comenzar y «Stop!» para parar. Para hablar del juego, puedes decir «The game starts now».",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "Start the game!",
              "examples": [
                "Start the game!",
                "Stop the ball!",
                "Our team can win."
              ]
            },
            {
              "label": "Práctica",
              "pattern": "Lee la frase, escucha el modelo y crea una frase parecida.",
              "examples": [
                "Start the game!",
                "Stop the ball!",
                "Our team can win."
              ]
            }
          ],
          "tip": "Escucha y repite. Fíjate en el orden de las palabras y usa el modelo para hablar."
        }
      }
