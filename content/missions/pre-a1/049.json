        "theory": {
          "title": "There is… e imperativos en una escena",
          "explanation": "«There is…» nos ayuda a decir qué hay en la playa: «There is a shell». Para dar instrucciones usamos un verbo al principio: «Find a shell». Así podemos describir la escena y pedir a alguien que busque un objeto.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "There is sand. Find a shell.",
              "examples": [
                "There is sand. Find a shell.",
                "Find a shell."
              ]
            },
            {
              "label": "Práctica",
              "pattern": "Elige la frase que describe la playa y sigue la instrucción para encontrar un objeto.",
              "examples": [
                "Find a shell."
              ]
            }
          ],
          "tip": "Lee el ejemplo y observa cómo se usa el vocabulario en una frase."
        }
