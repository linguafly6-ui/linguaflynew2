        "theory": {
          "title": "Have got: preguntas y respuestas breves",
          "explanation": "Preguntamos si alguien tiene algo con «Have you got…?». Respondemos «Yes, I have» si lo tenemos y «No, I haven’t» si no lo tenemos. La pregunta va seguida del objeto: «Have you got a pen?»",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "Have you got a pen? Yes, I have. / No, I haven't.",
              "examples": [
                "Have you got a pen? Yes, I have. / No, I haven't."
              ]
            },
            {
              "label": "Uso",
              "pattern": "Lee la pregunta y elige la respuesta que coincide con la situación.",
              "examples": [
                "Have you got a pen?"
              ]
            }
          ],
          "tip": "Observa el ejemplo y repite las frases en voz alta."
        }
