            {
              "label": "Modelo",
              "pattern": "Listen to me.",
              "examples": [
                "Listen to me.",
                "Open your book.",
                "Sit down, please."
              ]
            },
            {
              "label": "Uso",
              "pattern": "Escucha, observa el ejemplo y crea una frase parecida.",
              "examples": [
                "Listen to me.",
                "Open your book.",
                "Sit down, please."
              ]
            }
          ],
          "tip": "Escucha y repite. Fíjate en el orden de las palabras y practica con el modelo."
