      "exercise": {
        "exerciseId": "english-pre-a1-m058-reading-ex01",
        "type": "reading_comprehension",
        "content": {
          "passageId": "english-pre-a1-m058-reading-passage-01",
          "passage": "It is English class. The teacher says, “Good morning. Sit down, please.” The children open their books. First, they listen and look at the picture. Then they read a short text and write three words. The teacher says, “Repeat after me.” At the end, the children close their books and stand up."
        },
        "items": [
          {
            "itemId": "english-pre-a1-m058-reading-ex01-i01",
            "position": 1,
            "prompt": "What class is it?",
            "evaluation": {
              "type": "single_choice"
            },
            "options": [
              "English class",
              "Art class",
              "Music class"
            ]
          },
          {
            "itemId": "english-pre-a1-m058-reading-ex01-i02",
            "position": 2,
            "prompt": "What does the teacher say first?",
            "evaluation": {
              "type": "single_choice"
            },
            "options": [
              "Sit down, please",
              "Stand up now",
              "Close your books"
            ]
          },
          {
            "itemId": "english-pre-a1-m058-reading-ex01-i03",
            "position": 3,
            "prompt": "What do the children open?",
            "evaluation": {
              "type": "single_choice"
            },
            "options": [
              "Their books",
              "The windows",
              "Their bags"
            ]
          },
          {
            "itemId": "english-pre-a1-m058-reading-ex01-i04",
            "position": 4,
            "prompt": "What do the children do before reading?",
            "evaluation": {
              "type": "single_choice"
            },
            "options": [
              "Listen and look",
              "Run and jump",
