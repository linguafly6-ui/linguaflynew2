        "theory": {
          "title": "What's the weather like? It's…",
          "explanation": "Preguntamos «What’s the weather like?» para saber qué tiempo hace. Respondemos con «It’s…» y una palabra del tiempo: «It’s sunny», «It’s rainy» o «It’s cold». Podemos escoger una prenda que nos ayude con ese tiempo.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "What’s the weather like? It’s rainy.",
              "examples": [
                "What’s the weather like? It’s rainy.",
                "It's rainy."
              ]
            },
            {
              "label": "Práctica",
              "pattern": "Responde a la pregunta del tiempo y elige una prenda apropiada.",
              "examples": [
                "It's rainy."
              ]
            }
          ],
          "tip": "Lee el ejemplo y observa cómo se usa el vocabulario en una frase."
        }
      }
