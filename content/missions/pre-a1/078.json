        "theory": {
          "title": "En una fiesta de cumpleaños",
          "explanation": "Usa «It is my birthday» y «There is…» para describir una fiesta.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "It is my birthday.",
              "examples": [
                "It is my birthday.",
                "There is a cake.",
                "We sing a song."
              ]
            },
            {
              "label": "Uso",
              "pattern": "Lee la frase y usa el modelo para hablar de una situación parecida.",
              "examples": [
                "It is my birthday.",
                "There is a cake.",
                "We sing a song."
              ]
            }
          ],
          "tip": "Lee la frase completa, escucha el modelo y repítelo en voz alta."
        }
      }
