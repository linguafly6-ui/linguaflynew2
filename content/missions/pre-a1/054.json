        "theory": {
          "title": "Imperativo Spell…; nombres de letras",
          "explanation": "Usamos «Spell…» para pedir que alguien deletree una palabra. Después decimos los nombres de las letras una a una. El alfabeto inglés tiene 26 letras, desde A hasta Z. Por ejemplo, «Spell cat»: C – A – T. En esta misión reconocemos todas las letras y practicamos cómo formar palabras cortas.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "The alphabet: A, B, C… Z. Spell “cat”: C – A – T.",
              "examples": [
                "The alphabet: A, B, C… Z. Spell “cat”: C – A – T."
              ]
            },
            {
              "label": "Uso",
              "pattern": "Escucha o lee las letras y elige la secuencia correcta. Después localiza las letras iniciales y finales de palabras cortas.",
              "examples": [
                "A, B, C, D, E."
              ]
            }
          ],
          "tip": "Observa el ejemplo y repite las frases en voz alta."
        }
      }
