        "type": "vocabulary_pairs",
        "theory": {
          "title": "Days of the Week: using ON",
          "explanation": "Use ON before a day of the week when you say when something happens. Learn the days, then practise ON in simple sentences.",
          "patterns": [
            {
              "label": "ON + day",
              "pattern": "on + Monday / Tuesday / Wednesday …",
              "examples": [
                "I go to school on Monday.",
                "We play football on Saturday.",
                "My English lesson is on Friday."
              ]
            },
            {
              "label": "IN + part of the day or season",
              "pattern": "in + the morning / winter",
              "examples": [
                "I have breakfast in the morning.",
                "It is cold in winter."
              ]
            },
            {
              "label": "AT + clock time",
              "pattern": "at + eight o’clock",
              "examples": [
                "The lesson starts at eight o’clock."
              ]
            }
          ],
          "tip": "Remember: ON Monday, IN the morning, AT eight o’clock."
          "title": "Days of the Week: words and simple English",
          "explanation": "Learn ten useful words about days of the week. Listen to each British English model and repeat it.",
          "patterns": [
            {
              "label": "Useful sentence",
              "pattern": "The first day in this list is Monday.",
              "examples": [
                "Monday is the first day of my school week.",
                "Tuesday is after Monday.",
                "Wednesday is in the middle of the week."
              ]
            }
          ],
          "tip": "Say each new word aloud, then use it in a short sentence."
        },
