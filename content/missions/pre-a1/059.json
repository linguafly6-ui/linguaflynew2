        "theory": {
          "title": "What is this? It's a…; Is it a…?",
          "explanation": "Usamos «What is this?» para preguntar qué es un objeto cercano. Respondemos con «It’s a…» y el nombre: «It’s a pencil». También podemos preguntar «Is it a…?» y contestar «Yes» o «No» con ayuda del objeto que vemos.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "What is this? It's a pencil. Is it a book?",
              "examples": [
                "What is this? It's a pencil. Is it a book?"
              ]
            },
            {
              "label": "Uso",
              "pattern": "Observa el objeto y elige la pregunta o respuesta que encaja.",
              "examples": [
                "It's a pencil."
              ]
            }
          ],
          "tip": "Observa el ejemplo y repite las frases en voz alta."
        }
