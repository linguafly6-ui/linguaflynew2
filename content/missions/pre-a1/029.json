      "exercise": {
        "exerciseId": "english-pre-a1-m029-grammar-ex01",
        "type": "grammar",
        "theory": {
          "focus": "Etiquetas de parentesco; he / she",
          "explanation": "Usamos «he» para hablar de un hombre o un niño y «she» para hablar de una mujer o una niña. Para nombrar a un familiar podemos decir «my mother» o «my grandfather». Cuando hablamos de varias personas juntas, podemos reconocer «they».",
          "model": "She is my mother. He is my father.",
          "practice": "Relaciona cada familiar con He is o She is. Usa They are cuando hables de varias personas."
        },
        "items": [
          {
