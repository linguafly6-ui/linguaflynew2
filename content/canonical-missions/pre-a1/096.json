        "theory": {
          "title": "At the airport",
          "explanation": "Usa «I have…» para hablar de tus documentos y «The … is…» para describir el viaje.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "I have my passport.",
              "examples": [
                "I have my passport.",
                "The plane is on the runway.",
                "The pilot is on the plane."
              ]
            },
            {
              "label": "Uso",
              "pattern": "Lee el modelo y cambia una palabra para hablar de otra situación.",
              "examples": [
                "I have my passport.",
                "The plane is on the runway.",
                "The pilot is on the plane."
              ]
            }
          ],
          "tip": "Escucha la frase, repítela y cambia una palabra para crear un ejemplo propio."
        }
      }
