        "theory": {
          "title": "My daily routine: Times",
          "explanation": "Usa «in the morning / afternoon / evening» para hablar de momentos del día y «at night / bedtime» para hablar de la noche.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "I have breakfast in the morning.",
              "examples": [
                "I have breakfast in the morning.",
                "I eat lunch in the afternoon.",
                "I go to bed at night."
              ]
            },
            {
              "label": "Uso",
              "pattern": "Lee el modelo y cambia una palabra para hablar de otra situación.",
              "examples": [
                "I have breakfast in the morning.",
                "I eat lunch in the afternoon.",
                "I go to bed at night."
              ]
            }
          ],
          "tip": "Escucha la frase, repítela y cambia una palabra para crear un ejemplo propio."
        }
      }
