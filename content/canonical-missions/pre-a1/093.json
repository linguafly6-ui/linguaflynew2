        "theory": {
          "title": "In the living room",
          "explanation": "Usa «There is…» para describir lo que hay en una habitación y «The … is…» para decir dónde está.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "There is a sofa in the living room.",
              "examples": [
                "There is a sofa in the living room.",
                "The remote control is on the table.",
                "The clock is on the wall."
              ]
            },
            {
              "label": "Uso",
              "pattern": "Lee el modelo y cambia una palabra para hablar de otra situación.",
              "examples": [
                "There is a sofa in the living room.",
                "The remote control is on the table.",
                "The clock is on the wall."
              ]
            }
          ],
          "tip": "Escucha la frase, repítela y cambia una palabra para crear un ejemplo propio."
        }
      }
