        "theory": {
          "title": "Numbers 1–10 and counting",
          "explanation": "Los números nos ayudan a contar personas y objetos. Aprende su orden y cómo preguntar por cantidades con How many…? y responder con There is o There are.",
          "patterns": [
            {
              "label": "Números del 1 al 5",
              "pattern": "one · two · three · four · five",
              "examples": [
                "One apple.",
                "Two books.",
                "Three balls."
              ]
            },
            {
              "label": "Números del 6 al 10",
              "pattern": "six · seven · eight · nine · ten",
              "examples": [
                "Six pens.",
                "Seven cards.",
                "Ten fingers."
              ]
            },
            {
              "label": "Preguntar cantidades",
              "pattern": "How many + plural noun + are there?",
              "examples": [
                "How many books are there?",
                "How many balls are there?"
              ]
            },
            {
              "label": "Responder cantidades",
              "pattern": "There is + one + singular noun / There are + number + plural noun",
              "examples": [
                "There is one book.",
                "There are three balls."
              ]
            }
          ],
          "tip": "Usa How many con sustantivos contables en plural. Con una cosa puedes decir There is one…; con dos o más, There are…."
        }
      }
    },
