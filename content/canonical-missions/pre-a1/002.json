        "theory": {
          "title": "Números, plural y cantidades",
          "explanation": "Aprende primero los números del 1 al 10. Después observa cómo cambia un nombre al contar más de un objeto, cómo preguntar How many…? y cómo responder con There is (una cosa) o There are (varias).",
          "tip": "One book, two books. There is para una cosa; There are para dos o más.",
          "patterns": [
            {
              "label": "1. Números del 1 al 5",
              "pattern": "one · two · three · four · five",
              "examples": [
                "one apple — una manzana",
                "two books — dos libros",
                "three balls — tres pelotas"
              ]
            },
            {
              "label": "2. Números del 6 al 10",
              "pattern": "six · seven · eight · nine · ten",
              "examples": [
                "six pens — seis bolígrafos",
                "seven cards — siete tarjetas",
                "ten fingers — diez dedos"
              ]
            },
            {
              "label": "3. Singular y plural",
              "pattern": "one + singular noun · number + plural noun",
              "examples": [
                "one book — un libro",
                "two books — dos libros",
                "five pencils — cinco lápices"
              ]
            },
            {
              "label": "4. Preguntar y responder cantidades",
              "pattern": "How many + plural noun + are there? · There is one… · There are…",
              "examples": [
                "How many books are there? — ¿Cuántos libros hay?",
                "There is one book. — Hay un libro.",
                "There are three balls. — Hay tres pelotas."
              ]
            }
          ]
        },
        "lesson": {
          "phrases": [
            {
              "english": "How many books are there?",
              "spanish": "¿Cuántos libros hay?",
              "note": "How many pregunta por una cantidad."
            },
            {
              "english": "There is one book.",
              "spanish": "Hay un libro.",
              "note": "There is se usa con una sola cosa."
            },
            {
              "english": "There are three balls.",
              "spanish": "Hay tres pelotas.",
              "note": "There are se usa con dos o más cosas."
            },
            {
              "english": "one book / two books",
              "spanish": "un libro / dos libros",
              "note": "En muchos nombres se añade -s para formar el plural."
            },
            {
