          }
        ],
        "theory": {
          "title": "Presentarte con el verbo to be",
          "explanation": "Usamos to be para decir quiénes somos y presentar a otras personas. I am, you are, he is y she is. En saludos también usamos expresiones fijas como Good morning, Hello y Nice to meet you.",
          "patterns": [
            {
              "label": "Afirmativa",
              "pattern": "Subject + am/is/are + information",
              "examples": [
                "I am Alex.",
                "You are my friend.",
                "She is my teacher."
              ]
            },
            {
              "label": "Contracciones",
              "pattern": "I am → I'm · You are → You're · He is → He's · She is → She's",
              "examples": [
                "I'm Alex.",
                "You're my friend.",
                "She's Mia."
              ]
            },
            {
              "label": "Preguntas",
              "pattern": "Am/Is/Are + subject ...?",
              "examples": [
                "Are you a student?",
                "Is she your teacher?"
              ]
            },
            {
              "label": "Saludos",
              "pattern": "Good morning · Good afternoon · Hello · Goodbye",
              "examples": [
                "Good morning, Mia!",
                "Hello, my name is Alex.",
                "Nice to meet you."
              ]
            }
          ],
          "tip": "I siempre usa am; you usa are; he, she e it usan is."
        }
      }
    },
