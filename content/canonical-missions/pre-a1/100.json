        "theory": {
          "title": "Pre-A1 grand review",
          "explanation": "Combina saludos, personas, lugares y objetos con frases muy cortas. Recuerda «I am…», «I have…» y «This is…».",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "Hello! I am Alex.",
              "examples": [
                "Hello! I am Alex.",
                "This is my family.",
                "I have a book. Thank you!"
              ]
            },
            {
              "label": "Uso",
              "pattern": "Lee el modelo y cambia una palabra para crear una frase propia.",
              "examples": [
                "Hello! I am Alex.",
                "This is my family.",
                "I have a book. Thank you!"
              ]
            }
          ],
          "tip": "Escucha la frase, repítela y cambia una palabra para crear un ejemplo propio."
        }
