        "theory": {
          "title": "At the campsite",
          "explanation": "Usa «I am in…» para decir dónde estás y «I have…» para hablar del equipo que llevas.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "I am at the campsite.",
              "examples": [
                "I am at the campsite.",
                "My tent is near the lake.",
                "I have a sleeping bag."
              ]
            },
            {
              "label": "Pregunta y respuesta",
              "pattern": "Lee el modelo y cambia una palabra para hablar de otra cosa.",
              "examples": [
                "I am at the campsite.",
                "My tent is near the lake.",
                "I have a sleeping bag."
              ]
            }
          ],
          "tip": "Escucha el modelo, repite la frase y cambia una palabra para crear una frase nueva."
        }
      }
