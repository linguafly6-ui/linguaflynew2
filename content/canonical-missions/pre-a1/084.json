        "theory": {
          "title": "At the toy shop",
          "explanation": "Usa «I want…» para decir qué juguete quieres y «Have you got…?» para preguntar si hay uno disponible.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "I want a teddy bear.",
              "examples": [
                "I want a teddy bear.",
                "Have you got a toy train?",
                "The robot is blue."
              ]
            },
            {
              "label": "Pregunta y respuesta",
              "pattern": "Lee el modelo y cambia una palabra para hablar de otra cosa.",
              "examples": [
                "I want a teddy bear.",
                "Have you got a toy train?",
                "The robot is blue."
              ]
            }
          ],
          "tip": "Escucha el modelo, repite la frase y cambia una palabra para crear una frase nueva."
        }
      }
