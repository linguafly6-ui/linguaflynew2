              "spanish": "tu / tus",
              "note": "Your indica posesión de la persona a quien hablas."
            },
            {
              "english": "our",
              "spanish": "nuestro/a/os/as",
              "note": "Our indica posesión compartida."
            },
            {
              "english": "have got / has got",
              "spanish": "tener",
              "note": "Have got con I/you/we/they; has got con he/she/it."
            }
