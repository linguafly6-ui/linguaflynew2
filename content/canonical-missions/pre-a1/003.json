        "theory": {
          "title": "Colours: names and simple descriptions",
          "explanation": "Aprende diez colores y úsalos para describir objetos. En inglés, el color suele ir antes del nombre del objeto.",
          "patterns": [
            {
              "label": "Colour + noun",
              "pattern": "a + colour + noun",
              "examples": [
                "a red ball",
                "a blue sky",
                "a green tree"
              ]
            },
            {
              "label": "Describir algo",
              "pattern": "It is + a/an + colour + noun",
              "examples": [
                "It is a red flower.",
                "It is a blue ball.",
                "It is a green leaf."
              ]
            }
          ],
          "tip": "Primero decimos el color y después el objeto: a yellow sun, no a sun yellow."
        },
