        "theory": {
          "title": "At the seaside",
          "explanation": "Usa «There is…» para decir qué hay en la costa y «The … is…» para describir lugares y objetos.",
          "patterns": [
            {
              "label": "Modelo",
              "pattern": "There is a boat in the harbour.",
              "examples": [
                "There is a boat in the harbour.",
                "The lighthouse is tall.",
                "The sand is warm."
              ]
            },
            {
              "label": "Uso",
              "pattern": "Lee el modelo y cambia una palabra para hablar de otra situación.",
              "examples": [
                "There is a boat in the harbour.",
                "The lighthouse is tall.",
                "The sand is warm."
              ]
            }
          ],
          "tip": "Escucha la frase, repítela y cambia una palabra para crear un ejemplo propio."
        }
