        "theory": {
          "title": "El verbo TO BE: am / is / are",
          "explanation": "Usamos TO BE para decir quiénes somos, cómo estamos, nuestra edad o de dónde somos. En español suele equivaler a ser o estar.",
          "tip": "Sujeto + am/is/are + not. Ejemplo: I am not from London. Am/Is/Are + sujeto...? Ejemplo: Are you a student?",
          "patterns": [
            {
              "label": "Patrón 1",
              "pattern": "I am (I'm) · yo soy / estoy",
              "examples": [
                "I am (I'm) · yo soy / estoy"
              ]
            },
            {
              "label": "Patrón 2",
              "pattern": "You are (you're) · tú eres / estás",
              "examples": [
                "You are (you're) · tú eres / estás"
              ]
            },
            {
              "label": "Patrón 3",
              "pattern": "He / She / It is · él / ella es / está",
              "examples": [
                "He / She / It is · él / ella es / está"
              ]
            },
            {
              "label": "Patrón 4",
              "pattern": "We / You / They are · nosotros / vosotros / ellos somos / sois / son",
              "examples": [
                "We / You / They are · nosotros / vosotros / ellos somos / sois / son"
              ]
            }
          ]
        }
      },
      "title": "Exploración"
