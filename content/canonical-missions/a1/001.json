        "theory": {
          "title": "El verbo TO BE: am / is / are",
          "explain": "Usamos TO BE para decir quiénes somos, cómo estamos, nuestra edad o de dónde somos. En español suele equivaler a ser o estar.",
          "patterns": [
            "I am (I'm) · yo soy / estoy",
            "You are (you're) · tú eres / estás",
            "He / She / It is · él / ella es / está",
            "We / You / They are · nosotros / vosotros / ellos somos / sois / son"
          ],
          "negative": "Sujeto + am/is/are + not. Ejemplo: I am not from London.",
          "question": "Am/Is/Are + sujeto...? Ejemplo: Are you a student?",
          "examples": [
            [
              "I am twenty-four years old.",
              "Tengo veinticuatro años."
            ],
            [
              "She is from Spain.",
              "Ella es de España."
            ],
            [
              "They are students.",
              "Ellos son estudiantes."
            ]
          ]
        }
