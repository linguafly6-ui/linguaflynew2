        "theory": {
          "title": "Family members and relationships",
          "explanation": "Habla de la familia con vocabulario de parentesco. Usa my, your, his, her, our y their antes de un sustantivo: her brother. Para indicar posesión, añade ’s al nombre: Emma’s aunt. Usa whose para preguntar de quién es algo o quién es el familiar: Whose dad is this? Have got sirve para describir la familia: I’ve got two sisters. Para hablar de relaciones, usa get on well with, look after y each other.",
          "tip": "No confundas his (su, de él) con her (su, de ella). Con un nombre, usa ’s: Lucas’s sister. Whose pregunta por el dueño o la relación.",
          "patterns": [
            {
              "label": "Bloque 1 · Family members",
              "pattern": "mother, father, parents, children, siblings",
              "examples": [
                "I've got one brother.",
                "My parents live nearby."
              ]
            },
            {
              "label": "Bloque 2 · Grandparents",
              "pattern": "grandmother, grandfather, grandparents",
              "examples": [
                "My grandparents are very kind.",
                "Her grandad is  seventy."
              ]
            },
            {
              "label": "Bloque 3 · Aunts, uncles and cousins",
              "pattern": "aunt, uncle, cousin, niece, nephew",
              "examples": [
                "My aunt has two children.",
                "Their cousin is called Ben."
              ]
            },
            {
              "label": "Bloque 4 · Family situations",
              "pattern": "married, single, divorced, partner",
              "examples": [
                "My sister is married.",
                "His parents are divorced."
              ]
            },
            {
              "label": "Bloque 5 · Possessive adjectives",
              "pattern": "my, your, his, her, its, our, their + noun",
              "examples": [
                "That's our house.",
                "Is this her brother?"
              ]
            },
            {
              "label": "Bloque 6 · Possessive ’s",
              "pattern": "person + ’s + noun",
              "examples": [
                "Jack's dad is a teacher.",
                "My cousin's name is Ella."
              ]
            },
            {
              "label": "Bloque 7 · Whose questions",
              "pattern": "Whose + noun + is/are ...?",
              "examples": [
                "Whose phone is this?",
                "Whose parents are they?"
              ]
            },
            {
              "label": "Bloque 8 · Have got",
              "pattern": "have/has got + family member",
              "examples": [
                "I've got two sisters.",
                "He's got a big family."
              ]
            },
            {
              "label": "Bloque 9 · Relationships",
              "pattern": "get on well with; look after",
              "examples": [
                "I get on well with my cousins.",
                "She looks after her little brother."
              ]
            },
            {
              "label": "Bloque 10 · Reciprocal phrase",
              "pattern": "each other",
              "examples": [
                "We help each other.",
                "They visit each other every week."
              ]
            }
          ]
        },
        "lesson": {
          "phrases": [
            {
              "english": "Have you got any brothers or sisters?",
              "spanish": "¿Tienes hermanos o hermanas?"
            },
            {
              "english": "I've got one older brother and a younger sister.",
              "spanish": "Tengo un hermano mayor y una hermana menor."
            },
            {
              "english": "My aunt's name is Laura.",
              "spanish": "Mi tía se llama Laura."
            },
            {
              "english": "Whose daughter is she?",
              "spanish": "¿De quién es hija?"
            },
            {
              "english": "She's my uncle's daughter.",
              "spanish": "Es la hija de mi tío."
            },
            {
              "english": "We get on well with each other.",
              "spanish": "Nos llevamos bien."
            },
            {
              "english": "My grandparents look after my cousin on Fridays.",
              "spanish": "Mis abuelos cuidan de mi primo los viernes."
            },
            {
              "english": "Their family gets together every Sunday.",
              "spanish": "Su familia se reúne todos los domingos."
            }
          ],
          "grammar": [
            {
              "english": "I've got two sisters.",
              "spanish": "Tengo dos hermanas.",
              "note": "have got para hablar de la familia."
            },
            {
              "english": "My brother has got a new job.",
              "spanish": "Mi hermano tiene un trabajo nuevo.",
              "note": "has got con he/she/it."
            },
            {
              "english": "This is her daughter.",
              "spanish": "Esta es su hija.",
              "note": "her antes de un sustantivo."
            },
            {
              "english": "Our parents live in Bristol.",
              "spanish": "Nuestros padres viven en Bristol.",
              "note": "our indica posesión de nosotros."
            },
            {
              "english": "Daniel's uncle is a doctor.",
              "spanish": "El tío de Daniel es médico.",
              "note": "’s expresa posesión o relación familiar."
            },
            {
              "english": "My cousins' house is very big.",
              "spanish": "La casa de mis primos es muy grande.",
              "note": "Plural terminado en -s: añade solo apóstrofo."
            },
            {
              "english": "Whose brother is that?",
              "spanish": "¿De quién es ese hermano?",
              "note": "whose pregunta por la relación o posesión."
            },
            {
              "english": "Have you got any cousins?",
              "spanish": "¿Tienes primos?",
              "note": "Have + sujeto + got para preguntas."
            },
            {
              "english": "I look after my little sister.",
              "spanish": "Cuido de mi hermana pequeña.",
              "note": "look after + persona."
            },
            {
              "english": "They help each other.",
              "spanish": "Se ayudan mutuamente.",
              "note": "each other expresa reciprocidad."
            }
          ],
          "reading": [
            {
              "english": "Read the family profile and identify how the people are related.",
              "spanish": "Lee el perfil familiar e identifica el parentesco."
            },
            {
              "english": "Look for possessive adjectives and ’s.",
              "spanish": "Busca los adjetivos posesivos y el apóstrofo ’s."
            }
          ],
          "writing": [
            {
              "english": "Listen and write the family sentences.",
              "spanish": "Escucha y escribe las frases sobre la familia."
            },
            {
              "english": "Check possessive forms and apostrophes.",
              "spanish": "Comprueba las formas posesivas y los apóstrofos."
            }
          ],
          "speaking": [
            {
              "english": "Describe your family or an imaginary family.",
              "spanish": "Describe tu familia o una familia imaginaria."
            },
            {
              "english": "Explain who gets on well with whom.",
              "spanish": "Explica quién se lleva bien con quién."
            }
          ],
          "listening": [
            {
              "english": "Listen for family words and relationships.",
              "spanish": "Escucha las palabras de familia y los parentescos."
            },
            {
              "english": "Notice have got, whose and possessive ’s.",
              "spanish": "Fíjate en have got, whose y el posesivo ’s."
            }
          ]
        }
      }
    },
