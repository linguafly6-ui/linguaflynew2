        "theory": {
          "title": "Talking about celebrations and invitations",
          "explanation": "Use the present continuous for fixed future arrangements, be going to for intentions and plans, and the past simple to describe a finished celebration. Use Let's and Why don't we to make suggestions, and Would you like to to invite someone politely. Accept or refuse invitations with friendly expressions.",
          "tip": "Use the present continuous with a future time expression for arrangements. After Let's and Why don't we, use the base form of the verb.",
          "patterns": [
            {
              "label": "Block 1 · Talk about a special day",
              "pattern": "It's my + occasion",
              "examples": [
                "It's my birthday on Saturday.",
                "Their wedding is in June."
              ]
            },
            {
              "label": "Block 2 · Make an invitation",
              "pattern": "Would you like to + base verb?",
              "examples": [
                "Would you like to come to my party?",
                "Would you like to join us for dinner?"
              ]
            },
            {
              "label": "Block 3 · Accept an invitation",
              "pattern": "Yes, I'd love to.",
              "examples": [
                "Yes, I'd love to. Thanks for inviting me.",
                "That sounds great!"
              ]
            },
            {
              "label": "Block 4 · Refuse politely",
              "pattern": "I'm sorry, I can't. I have to + verb",
              "examples": [
                "I'm sorry, I can't. I have to work.",
                "Thanks, but I'm busy that evening."
              ]
            },
            {
              "label": "Block 5 · Make a suggestion",
              "pattern": "Let's + base verb",
              "examples": [
                "Let's have the party at home.",
                "Let's book a table."
              ]
            },
            {
              "label": "Block 6 · Suggest an activity",
              "pattern": "Why don't we + base verb?",
              "examples": [
                "Why don't we decorate the room?",
                "Why don't we buy a cake?"
              ]
            },
            {
              "label": "Block 7 · Talk about arrangements",
              "pattern": "am/is/are + verb-ing + future time",
              "examples": [
                "We're meeting at seven tonight.",
                "She's having a party on Friday."
              ]
            },
            {
              "label": "Block 8 · Talk about intentions",
              "pattern": "am/is/are going to + base verb",
              "examples": [
                "I'm going to make a cake.",
                "They are going to invite their neighbours."
              ]
            },
            {
              "label": "Block 9 · Describe a past celebration",
              "pattern": "Past simple",
              "examples": [
                "We danced and played games.",
                "My friends gave me a lovely present."
              ]
            },
            {
              "label": "Block 10 · Congratulate someone",
              "pattern": "Congratulations on + noun",
              "examples": [
                "Congratulations on your wedding!",
                "Happy anniversary!"
              ]
            }
          ]
        },
        "lesson": {
          "phrases": [
            {
              "english": "Would you like to come to my birthday party?",
              "spanish": "¿Te gustaría venir a mi fiesta de cumpleaños?"
            },
            {
              "english": "Yes, I'd love to. Thank you!",
              "spanish": "¡Sí, me encantaría! ¡Gracias!"
            },
            {
              "english": "I'm sorry, I can't make it on Saturday.",
              "spanish": "Lo siento, no puedo ir el sábado."
            },
            {
              "english": "Let's meet at the restaurant at eight.",
              "spanish": "Quedemos en el restaurante a las ocho."
            },
            {
              "english": "We're having a family celebration next weekend.",
              "spanish": "Vamos a celebrar algo en familia el próximo fin de semana."
            },
            {
              "english": "I'm going to buy a present for Mia.",
              "spanish": "Voy a comprar un regalo para Mia."
            },
            {
              "english": "Why don't we make a chocolate cake?",
              "spanish": "¿Por qué no hacemos una tarta de chocolate?"
            },
            {
              "english": "Congratulations on your anniversary!",
              "spanish": "¡Feliz aniversario!"
            }
          ],
          "grammar": [
            {
              "english": "Would you like to come to the party?",
              "spanish": "Polite invitations",
              "note": "Use would you like to + base verb."
            },
            {
              "english": "I'd love to come.",
              "spanish": "Accepting invitations",
              "note": "Use I'd love to to accept warmly."
            },
            {
              "english": "I can't come because I'm working.",
              "spanish": "Refusing politely",
              "note": "Give a short reason after a polite refusal."
            },
            {
              "english": "Let's decorate the room.",
              "spanish": "Let's + base verb",
              "note": "Use Let's to make a suggestion."
            },
            {
              "english": "Why don't we book a table?",
              "spanish": "Why don't we",
              "note": "Follow with the base form of the verb."
            },
            {
              "english": "We're meeting at six tomorrow.",
              "spanish": "Present continuous for arrangements",
              "note": "Use it for fixed future plans."
            },
            {
              "english": "I'm going to make a cake.",
              "spanish": "Going to",
              "note": "Use it for intentions and plans."
            },
            {
              "english": "They invited twenty guests.",
              "spanish": "Past simple",
              "note": "Use the past simple for a finished event."
            },
            {
              "english": "We danced all evening.",
              "spanish": "Past simple regular verbs",
              "note": "Add -ed to regular verbs."
            },
            {
              "english": "She bought a beautiful present.",
              "spanish": "Past simple irregular verbs",
              "note": "Bought is the past form of buy."
            }
          ],
          "reading": [
            {
              "english": "Read about a birthday celebration and identify the arrangements, guests and activities.",
              "spanish": "Lee sobre una celebración de cumpleaños e identifica planes, invitados y actividades."
            }
          ],
          "writing": [
            {
              "english": "Write an invitation and describe a celebration you enjoyed.",
              "spanish": "Escribe una invitación y describe una celebración que disfrutaste."
            }
          ],
          "speaking": [
            {
              "english": "Invite a friend to a special occasion and respond to an invitation.",
              "spanish": "Invita a un amigo a una ocasión especial y responde a una invitación."
            }
          ],
          "listening": [
            {
              "english": "Listen to two friends arranging a surprise birthday party.",
              "spanish": "Escucha a dos amigos organizar una fiesta sorpresa de cumpleaños."
            }
          ]
        }
      }
    },
