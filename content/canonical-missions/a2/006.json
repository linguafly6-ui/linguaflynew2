        "theory": {
          "title": "Daily routines and telling the time",
          "explanation": "Use the present simple to describe routines. Add -s to most verbs with he and she: I get up at seven; she gets up at seven. Use do/does for questions and don't/doesn't for negatives. Put frequency adverbs before most main verbs: I usually have breakfast. Use at with clock times, in the morning/afternoon/evening, and on with days.",
          "tip": "After doesn't, use the base verb: He doesn't work on Sundays. Say at seven o'clock, but in the morning.",
          "patterns": [
            {
              "label": "Block 1 · Morning routine",
              "pattern": "wake up; get up; have breakfast",
              "examples": [
                "I wake up at seven.",
                "She has breakfast at half past seven."
              ]
            },
            {
              "label": "Block 2 · Getting ready",
              "pattern": "have a shower; get dressed; brush my teeth",
              "examples": [
                "He has a shower before work.",
                "I brush my teeth every morning."
              ]
            },
            {
              "label": "Block 3 · Travel and work",
              "pattern": "leave home; catch the bus; start work",
              "examples": [
                "We leave home at eight.",
                "My dad catches the bus."
              ]
            },
            {
              "label": "Block 4 · Meals and home",
              "pattern": "have lunch; cook dinner; do the washing-up",
              "examples": [
                "I have lunch at one.",
                "They cook dinner together."
              ]
            },
            {
              "label": "Block 5 · Evening activities",
              "pattern": "get home; do homework; go to bed",
              "examples": [
                "She gets home at six.",
                "I go to bed at eleven."
              ]
            },
            {
              "label": "Block 6 · Telling the time",
              "pattern": "at seven; half past; quarter past; quarter to",
              "examples": [
                "It's quarter past eight.",
                "The lesson starts at half past nine."
              ]
            },
            {
              "label": "Block 7 · Parts of the day",
              "pattern": "in the morning/afternoon/evening; at night",
              "examples": [
                "I study in the evening.",
                "He reads at night."
              ]
            },
            {
              "label": "Block 8 · Frequency",
              "pattern": "always; usually; often; sometimes; never",
              "examples": [
                "I usually walk to work.",
                "She never skips breakfast."
              ]
            },
            {
              "label": "Block 9 · How often",
              "pattern": "once/twice a week; every day",
              "examples": [
                "We play tennis twice a week.",
                "He studies every day."
              ]
            },
            {
              "label": "Block 10 · Questions and negatives",
              "pattern": "Do/Does ...?; don't/doesn't + base verb",
              "examples": [
                "Do you work at weekends?",
                "She doesn't get up early on Sundays."
              ]
            }
          ]
        },
        "lesson": {
          "phrases": [
            {
              "english": "What time do you get up?",
              "spanish": "¿A qué hora te levantas?"
            },
            {
              "english": "I usually get up at half past seven.",
              "spanish": "Normalmente me levanto a las siete y media."
            },
            {
              "english": "She catches the bus at quarter past eight.",
              "spanish": "Ella coge el autobús a las ocho y cuarto."
            },
            {
              "english": "We have lunch at one o'clock.",
              "spanish": "Comemos a la una."
            },
            {
              "english": "He doesn't work on Sundays.",
              "spanish": "Él no trabaja los domingos."
            },
            {
              "english": "How often do you do homework?",
              "spanish": "¿Con qué frecuencia haces los deberes?"
            },
            {
              "english": "I sometimes cook dinner in the evening.",
              "spanish": "A veces preparo la cena por la tarde-noche."
            },
            {
              "english": "They go to bed before eleven.",
              "spanish": "Se acuestan antes de las once."
            }
          ],
          "grammar": [
            {
              "english": "I get up at seven.",
              "spanish": "Me levanto a las siete.",
              "note": "Present simple con I."
            },
            {
              "english": "She gets up at seven.",
              "spanish": "Ella se levanta a las siete.",
              "note": "Añade -s con he/she/it."
            },
            {
              "english": "Do you have breakfast early?",
              "spanish": "¿Desayunas temprano?",
              "note": "Do para preguntas con I/you/we/they."
            },
            {
              "english": "Does he catch the bus?",
              "spanish": "¿Coge él el autobús?",
              "note": "Does + verbo base."
            },
            {
              "english": "I don't work at weekends.",
              "spanish": "No trabajo los fines de semana.",
              "note": "don't + verbo base."
            },
            {
              "english": "She doesn't cook every day.",
              "spanish": "Ella no cocina todos los días.",
              "note": "doesn't + verbo base."
            },
            {
              "english": "I usually walk to work.",
              "spanish": "Normalmente voy andando al trabajo.",
              "note": "El adverbio suele ir antes del verbo principal."
            },
            {
              "english": "We sometimes study in the evening.",
              "spanish": "A veces estudiamos por la tarde.",
              "note": "Sometimes expresa frecuencia."
            },
            {
              "english": "The train leaves at quarter to nine.",
              "spanish": "El tren sale a las nueve menos cuarto.",
              "note": "At + hora."
            },
            {
              "english": "He has lunch at one o'clock.",
              "spanish": "Él come a la una.",
              "note": "Have cambia a has con he/she/it."
            }
          ],
          "reading": [
            {
              "english": "Read about two people's weekday routines.",
              "spanish": "Lee sobre las rutinas entre semana de dos personas."
            }
          ],
          "writing": [
            {
              "english": "Listen and write routine sentences and times.",
              "spanish": "Escucha y escribe frases de rutinas y horas."
            }
          ],
          "speaking": [
            {
              "english": "Describe a typical weekday and compare routines.",
              "spanish": "Describe un día normal y compara rutinas."
            }
          ],
          "listening": [
            {
              "english": "Listen for times, routine verbs and frequency words.",
              "spanish": "Escucha horas, verbos de rutina y adverbios de frecuencia."
            }
          ]
        }
      }
    },
