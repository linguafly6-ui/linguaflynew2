        "theory": {
          "title": "Using a sports centre",
          "explanation": "Ask about facilities with Is there...? and Are there...? Use the present simple for opening hours and class timetables. Use can to ask permission and could to make polite requests. Use have to for rules and don't have to when something is not necessary. Ask How much...? about prices.",
          "tip": "After does, can, could and have to, use the base form of the main verb.",
          "patterns": [
            {
              "label": "Block 1 · Ask about facilities",
              "pattern": "Is there / Are there + noun?",
              "examples": [
                "Is there a swimming pool?",
                "Are there any lockers?"
              ]
            },
            {
              "label": "Block 2 · Ask about opening times",
              "pattern": "What time does + place + open/close?",
              "examples": [
                "What time does the gym open?",
                "It closes at nine."
              ]
            },
            {
              "label": "Block 3 · Ask about prices",
              "pattern": "How much is + singular / are + plural?",
              "examples": [
                "How much is a day pass?",
                "How much are the classes?"
              ]
            },
            {
              "label": "Block 4 · Present simple for timetables",
              "pattern": "subject + present simple + time",
              "examples": [
                "The yoga class starts at six.",
                "The pool closes at eight."
              ]
            },
            {
              "label": "Block 5 · Can for permission",
              "pattern": "Can I + base verb...?",
              "examples": [
                "Can I use the lockers?",
                "Can I book a class here?"
              ]
            },
            {
              "label": "Block 6 · Could for polite requests",
              "pattern": "Could I + base verb...?",
              "examples": [
                "Could I join the fitness class?",
                "Could I speak to the trainer?"
              ]
            },
            {
              "label": "Block 7 · Have to for rules",
              "pattern": "subject + have to + base verb",
              "examples": [
                "You have to wear trainers.",
                "Members have to show a card."
              ]
            },
            {
              "label": "Block 8 · Don't have to",
              "pattern": "subject + don't/doesn't have to + base verb",
              "examples": [
                "You don't have to book the gym.",
                "She doesn't have to pay today."
              ]
            },
            {
              "label": "Block 9 · There is / are",
              "pattern": "There is + singular / There are + plural",
              "examples": [
                "There is a café upstairs.",
                "There are two changing rooms."
              ]
            },
            {
              "label": "Block 10 · Booking a place",
              "pattern": "I'd like to book + noun",
              "examples": [
                "I'd like to book a place on the class.",
                "Is there a space for two?"
              ]
            }
          ]
        },
        "lesson": {
          "phrases": [
            {
              "english": "I'd like to join the sports centre, please.",
              "spanish": "Me gustaría inscribirme en el polideportivo, por favor."
            },
            {
              "english": "Is the swimming pool open today?",
              "spanish": "¿Está abierta hoy la piscina?"
            },
            {
              "english": "What time does the fitness class start?",
              "spanish": "¿A qué hora empieza la clase de ejercicio?"
            },
            {
              "english": "Could I book a place for Tuesday?",
              "spanish": "¿Podría reservar una plaza para el martes?"
            },
            {
              "english": "Are there any lockers in the changing room?",
              "spanish": "¿Hay taquillas en el vestuario?"
            },
            {
              "english": "You have to wear trainers in the sports hall.",
              "spanish": "Tienes que llevar zapatillas deportivas en el pabellón."
            },
            {
              "english": "How much is a monthly membership?",
              "spanish": "¿Cuánto cuesta una membresía mensual?"
            },
            {
              "english": "I'm sorry, the class is full.",
              "spanish": "Lo siento, la clase está completa."
            }
          ],
          "grammar": [
            {
              "english": "There is a gym on the first floor.",
              "spanish": "There is",
              "note": "Use there is with a singular noun."
            },
            {
              "english": "There are two swimming pools.",
              "spanish": "There are",
              "note": "Use there are with plural nouns."
            },
            {
              "english": "What time does the gym open?",
              "spanish": "Present simple question",
              "note": "Does + subject + base verb."
            },
            {
              "english": "The class starts at half past six.",
              "spanish": "Timetables",
              "note": "Present simple for scheduled times."
            },
            {
              "english": "Can I use the treadmill?",
              "spanish": "Permission",
              "note": "Can + subject + base verb?"
            },
            {
              "english": "Could I book a place?",
              "spanish": "Polite request",
              "note": "Could + subject + base verb?"
            },
            {
              "english": "You have to wear trainers.",
              "spanish": "Obligation",
              "note": "Have to + base verb."
            },
            {
              "english": "You don't have to book the gym.",
              "spanish": "No obligation",
              "note": "Don't have to means it isn't necessary."
            },
            {
              "english": "How much is a day pass?",
              "spanish": "Price question",
              "note": "How much is + singular noun?"
            },
            {
              "english": "Are there any lockers?",
              "spanish": "Any in questions",
              "note": "Use any in many questions."
            }
          ],
          "reading": [
            {
              "english": "Read a sports centre information page and find the facilities, prices and opening hours.",
              "spanish": "Lee una página informativa de un polideportivo y encuentra instalaciones, precios y horarios."
            }
          ],
          "writing": [
            {
              "english": "Write a message to ask about membership and book a fitness class.",
              "spanish": "Escribe un mensaje para preguntar por la membresía y reservar una clase."
            }
          ],
          "speaking": [
            {
              "english": "Ask a receptionist about facilities, prices and class times.",
              "spanish": "Pregunta a recepción por las instalaciones, precios y horarios de clases."
            }
          ],
          "listening": [
            {
              "english": "Listen to a receptionist explain the sports centre facilities and rules.",
              "spanish": "Escucha a un recepcionista explicar las instalaciones y normas."
            }
          ]
        }
      }
    },
