        "theory": {
          "title": "Introductions and personal profiles",
          "explanation": "Use What’s your name? and How old are you? to ask for personal information. Use I’m from… to say where you come from, I live in… for your home, and I speak… for languages. In the present simple, add -s with he and she: She works in a shop. Use do/does to ask about routines and personal details: Where do you work? What languages does he speak? Use also to add information and because to give a reason.",
          "tip": "Use do with I/you/we/they and does with he/she/it. After does, use the base verb: Where does she live? not Where does she lives.",
          "patterns": [
            {
              "label": "Block 1 · Asking names",
              "pattern": "What's your name? / What's his full name?",
              "examples": [
                "My name is Alex Brown.",
                "Her full name is Mia Jones."
              ]
            },
            {
              "label": "Block 2 · Personal details",
              "pattern": "How old are you? / When is your birthday?",
              "examples": [
                "I'm twenty-four.",
                "My birthday is in May."
              ]
            },
            {
              "label": "Block 3 · Countries and nationalities",
              "pattern": "I'm from + country; I'm + nationality",
              "examples": [
                "I'm from Spain.",
                "He's British."
              ]
            },
            {
              "label": "Block 4 · Languages",
              "pattern": "speak + language",
              "examples": [
                "I speak Spanish and English.",
                "She speaks French."
              ]
            },
            {
              "label": "Block 5 · Present simple",
              "pattern": "I/you/we/they work; he/she works",
              "examples": [
                "I study English.",
                "My neighbour works in a bank."
              ]
            },
            {
              "label": "Block 6 · Questions with do",
              "pattern": "Do + subject + base verb ...?",
              "examples": [
                "Do you live near here?",
                "Do they study together?"
              ]
            },
            {
              "label": "Block 7 · Questions with does",
              "pattern": "Does + he/she + base verb ...?",
              "examples": [
                "Does she speak Italian?",
                "Where does he work?"
              ]
            },
            {
              "label": "Block 8 · Introducing someone",
              "pattern": "This is + name; He/She is my ...",
              "examples": [
                "This is my colleague, Sam.",
                "She's my classmate."
              ]
            },
            {
              "label": "Block 9 · Adding information",
              "pattern": "also; and; but; because",
              "examples": [
                "I also speak Catalan.",
                "He is friendly because he helps everyone."
              ]
            },
            {
              "label": "Block 10 · Short profile",
              "pattern": "name + age + origin + languages + work/study",
              "examples": [
                "I'm Leo, I'm  twenty, and I come from Madrid.",
                "She lives in Leeds and studies biology."
              ]
            }
          ]
        },
        "lesson": {
          "phrases": [
            {
              "english": "Hello, I'm Alex. What's your name?",
              "spanish": "Hola, soy Alex. ¿Cómo te llamas?"
            },
            {
              "english": "My full name is Sofia García.",
              "spanish": "Mi nombre completo es Sofia García."
            },
            {
              "english": "Where are you from?",
              "spanish": "¿De dónde eres?"
            },
            {
              "english": "I come from Valencia, but I live in London.",
              "spanish": "Soy de Valencia, pero vivo en Londres."
            },
            {
              "english": "What languages do you speak?",
              "spanish": "¿Qué idiomas hablas?"
            },
            {
              "english": "I speak Spanish and a little English.",
              "spanish": "Hablo español y un poco de inglés."
            },
            {
              "english": "This is my classmate, Daniel.",
              "spanish": "Este es mi compañero de clase, Daniel."
            },
            {
              "english": "She works in a café and studies at college.",
              "spanish": "Trabaja en una cafetería y estudia en un centro universitario."
            }
          ],
          "grammar": [
            {
              "english": "I live in Barcelona.",
              "spanish": "Vivo en Barcelona.",
              "note": "Present simple con I."
            },
            {
              "english": "He lives near the station.",
              "spanish": "Él vive cerca de la estación.",
              "note": "Añade -s con he/she/it."
            },
            {
              "english": "Do you speak English?",
              "spanish": "¿Hablas inglés?",
              "note": "Do + sujeto + verbo base."
            },
            {
              "english": "Does she work here?",
              "spanish": "¿Trabaja ella aquí?",
              "note": "Does con he/she/it; el verbo queda en forma base."
            },
            {
              "english": "Where do they study?",
              "spanish": "¿Dónde estudian?",
              "note": "Wh-word + do + sujeto + verbo."
            },
            {
              "english": "What does he do?",
              "spanish": "¿A qué se dedica?",
              "note": "Does seguido del verbo base."
            },
            {
              "english": "I'm from Spain, but I live in Bristol.",
              "spanish": "Soy de España, pero vivo en Bristol.",
              "note": "But contrasta dos ideas."
            },
            {
              "english": "She also speaks French.",
              "spanish": "Ella también habla francés.",
              "note": "Also añade información."
            },
            {
              "english": "He's friendly because he helps people.",
              "spanish": "Es amable porque ayuda a la gente.",
              "note": "Because introduce una razón."
            },
            {
              "english": "This is my neighbour, Paula.",
              "spanish": "Esta es mi vecina, Paula.",
              "note": "This is presenta a una persona."
            }
          ],
          "reading": [
            {
              "english": "Read a short personal profile and find the key details.",
              "spanish": "Lee un perfil personal e identifica los datos clave."
            }
          ],
          "writing": [
            {
              "english": "Listen and write the personal information accurately.",
              "spanish": "Escucha y escribe correctamente la información personal."
            }
          ],
          "speaking": [
            {
              "english": "Introduce yourself and another person.",
              "spanish": "Preséntate y presenta a otra persona."
            }
          ],
          "listening": [
            {
              "english": "Listen for names, places, ages and languages.",
              "spanish": "Escucha nombres, lugares, edades e idiomas."
            }
          ]
        }
      }
    },
