        "theory": {
          "title": "Talking about education and learning",
          "explanation": "Use the present simple to describe your studies and school routines. Use should/shouldn't to give advice, must/mustn't for important rules, and need to/don't need to for necessity. Use too and enough to describe difficulty. Ask how long a course or task takes.",
          "tip": "After should, must and need to, use the base form of the verb. Don't use to after should or must.",
          "patterns": [
            {
              "label": "Block 1 · Talk about your studies",
              "pattern": "I study + subject",
              "examples": [
                "I study English twice a week.",
                "She studies science at college."
              ]
            },
            {
              "label": "Block 2 · Describe a timetable",
              "pattern": "My lesson starts/finishes at + time",
              "examples": [
                "My lesson starts at nine.",
                "We finish school at half past three."
              ]
            },
            {
              "label": "Block 3 · Talk about homework",
              "pattern": "I have to + base verb",
              "examples": [
                "I have to finish my homework tonight.",
                "He has to prepare a project."
              ]
            },
            {
              "label": "Block 4 · Give study advice",
              "pattern": "You should/shouldn't + base verb",
              "examples": [
                "You should revise before the exam.",
                "You shouldn't study all night."
              ]
            },
            {
              "label": "Block 5 · Explain rules",
              "pattern": "You must/mustn't + base verb",
              "examples": [
                "You must arrive on time.",
                "You mustn't use your phone in the test."
              ]
            },
            {
              "label": "Block 6 · Talk about necessity",
              "pattern": "I need to/don't need to + base verb",
              "examples": [
                "I need to read this chapter.",
                "We don't need to bring a dictionary."
              ]
            },
            {
              "label": "Block 7 · Describe difficulty",
              "pattern": "too + adjective / adjective + enough",
              "examples": [
                "This exercise is too difficult.",
                "The explanation is clear enough."
              ]
            },
            {
              "label": "Block 8 · Ask about duration",
              "pattern": "How long does + subject + take?",
              "examples": [
                "How long does the exam take?",
                "It takes one hour."
              ]
            },
            {
              "label": "Block 9 · Talk about results",
              "pattern": "I got + mark/grade",
              "examples": [
                "I got a good mark in English.",
                "She got a high grade in maths."
              ]
            },
            {
              "label": "Block 10 · Describe progress",
              "pattern": "I want to improve my + noun",
              "examples": [
                "I want to improve my pronunciation.",
                "He practises every day."
              ]
            }
          ]
        },
        "lesson": {
          "phrases": [
            {
              "english": "I have an English lesson on Tuesday.",
              "spanish": "Tengo clase de inglés el martes."
            },
            {
              "english": "We have to hand in the project by Friday.",
              "spanish": "Tenemos que entregar el proyecto antes del viernes."
            },
            {
              "english": "You should revise your notes every day.",
              "spanish": "Deberías repasar tus apuntes todos los días."
            },
            {
              "english": "How long does the course last?",
              "spanish": "¿Cuánto dura el curso?"
            },
            {
              "english": "I got a good mark in the test.",
              "spanish": "Saqué buena nota en la prueba."
            },
            {
              "english": "This exercise is too difficult for me.",
              "spanish": "Este ejercicio es demasiado difícil para mí."
            },
            {
              "english": "You don't need to bring a dictionary.",
              "spanish": "No necesitas traer un diccionario."
            },
            {
              "english": "I study with a group of classmates.",
              "spanish": "Estudio con un grupo de compañeros."
            }
          ],
          "grammar": [
            {
              "english": "I study English twice a week.",
              "spanish": "Present simple",
              "note": "Use it for regular study routines."
            },
            {
              "english": "She finishes her homework after dinner.",
              "spanish": "Third-person -s",
              "note": "Add -s with he, she and it."
            },
            {
              "english": "You should check your answers.",
              "spanish": "Should",
              "note": "Use should + base verb for advice."
            },
            {
              "english": "You mustn't talk during the exam.",
              "spanish": "Mustn't",
              "note": "Use mustn't for a prohibition."
            },
            {
              "english": "I need to revise this unit.",
              "spanish": "Need to",
              "note": "Use need to + base verb for necessity."
            },
            {
              "english": "We don't need to buy the book.",
              "spanish": "Don't need to",
              "note": "It means something is not necessary."
            },
            {
              "english": "The text is too long.",
              "spanish": "Too + adjective",
              "note": "Too means more than is wanted or possible."
            },
            {
              "english": "The room is quiet enough to study.",
              "spanish": "Adjective + enough",
              "note": "Enough comes after an adjective."
            },
            {
              "english": "How long does the lesson take?",
              "spanish": "How long",
              "note": "Ask about duration."
            },
            {
              "english": "I got a high mark in science.",
              "spanish": "Past simple",
              "note": "Use got to talk about a finished result."
            }
          ],
          "reading": [
            {
              "english": "Read a student profile and identify subjects, study habits and exam results.",
              "spanish": "Lee el perfil de un estudiante e identifica asignaturas, hábitos y resultados."
            }
          ],
          "writing": [
            {
              "english": "Write about your courses, timetable and ways to improve your English.",
              "spanish": "Escribe sobre tus cursos, horario y formas de mejorar tu inglés."
            }
          ],
          "speaking": [
            {
              "english": "Describe your favourite subject and give advice to a classmate.",
              "spanish": "Describe tu asignatura favorita y aconseja a un compañero."
            }
          ],
          "listening": [
            {
              "english": "Listen to two students talking about homework, revision and an upcoming exam.",
              "spanish": "Escucha a dos estudiantes hablar de deberes, repaso y un próximo examen."
            }
          ]
        }
      }
