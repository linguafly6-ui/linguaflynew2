        "theory": {
          "title": "Using devices and communicating online",
          "explanation": "Use can and can't to talk about what a device or app can do. Use the present continuous for actions happening now. Object pronouns (me, you, him, her, it, us, them) come after verbs and prepositions. Use imperatives to give simple instructions.",
          "tip": "Say turn it on, send it to me and I am using it now. Object pronouns usually follow the verb.",
          "patterns": [
            {
              "label": "Block 1 · What a device can do",
              "pattern": "subject + can/can't + base verb",
              "examples": [
                "You can send photos with this app.",
                "My tablet can't make phone calls."
              ]
            },
            {
              "label": "Block 2 · Present continuous now",
              "pattern": "am/is/are + verb-ing",
              "examples": [
                "I'm downloading a file.",
                "She is talking to her friend."
              ]
            },
            {
              "label": "Block 3 · Object pronouns",
              "pattern": "verb + me/you/him/her/it/us/them",
              "examples": [
                "Please call me later.",
                "I use it every day."
              ]
            },
            {
              "label": "Block 4 · Pronouns after prepositions",
              "pattern": "preposition + object pronoun",
              "examples": [
                "This message is for her.",
                "Can you come with us?"
              ]
            },
            {
              "label": "Block 5 · Give instructions",
              "pattern": "imperative verb + object",
              "examples": [
                "Open the app.",
                "Turn your phone off."
              ]
            },
            {
              "label": "Block 6 · Negative instructions",
              "pattern": "Don't + base verb",
              "examples": [
                "Don't share your password.",
                "Don't close the website."
              ]
            },
            {
              "label": "Block 7 · Asking for help",
              "pattern": "How do I + base verb...?",
              "examples": [
                "How do I save this photo?",
                "How do I attach a file?"
              ]
            },
            {
              "label": "Block 8 · Asking permission",
              "pattern": "Can I + base verb...?",
              "examples": [
                "Can I use your charger?",
                "Can I send you a message?"
              ]
            },
            {
              "label": "Block 9 · Describing problems",
              "pattern": "The battery/screen/app + is + adjective",
              "examples": [
                "The battery is low.",
                "The screen is broken."
              ]
            },
            {
              "label": "Block 10 · Sending something",
              "pattern": "send + noun + to + person",
              "examples": [
                "Send the photo to me.",
                "I'll send the file to him."
              ]
            }
          ]
        },
        "lesson": {
          "phrases": [
            {
              "english": "Can you send me the photo, please?",
              "spanish": "¿Puedes enviarme la foto, por favor?"
            },
            {
              "english": "My phone battery is nearly empty.",
              "spanish": "La batería de mi móvil está casi agotada."
            },
            {
              "english": "I'm downloading an app at the moment.",
              "spanish": "Estoy descargando una aplicación ahora mismo."
            },
            {
              "english": "How do I attach a file to this email?",
              "spanish": "¿Cómo adjunto un archivo a este correo?"
            },
            {
              "english": "Please don't share your password.",
              "spanish": "Por favor, no compartas tu contraseña."
            },
            {
              "english": "I'll reply to your message later.",
              "spanish": "Responderé a tu mensaje más tarde."
            },
            {
              "english": "Can I use your charger for a minute?",
              "spanish": "¿Puedo usar tu cargador un minuto?"
            },
            {
              "english": "The video call is starting now.",
              "spanish": "La videollamada está empezando ahora."
            }
          ],
          "grammar": [
            {
              "english": "I can make video calls on my tablet.",
              "spanish": "Can",
              "note": "Use can + base verb for ability or possibility."
            },
            {
              "english": "This old phone can't download that app.",
              "spanish": "Can't",
              "note": "Use can't + base verb for something that is not possible."
            },
            {
              "english": "I'm sending you a message.",
              "spanish": "Present continuous",
              "note": "Use am/is/are + -ing for an action happening now."
            },
            {
              "english": "She is talking to him.",
              "spanish": "Object pronoun",
              "note": "Use him after the verb or preposition."
            },
            {
              "english": "Please send it to me.",
              "spanish": "Object pronouns",
              "note": "Use it for a thing and me for the person receiving it."
            },
            {
              "english": "Open the website and sign in.",
              "spanish": "Imperatives",
              "note": "Use the base form to give instructions."
            },
            {
              "english": "Don't tell anyone your password.",
              "spanish": "Negative imperative",
              "note": "Use don't + base verb."
            },
            {
              "english": "Can I borrow your headphones?",
              "spanish": "Permission",
              "note": "Can I + base verb is a simple polite request."
            },
            {
              "english": "The battery is getting low.",
              "spanish": "Describing a problem",
              "note": "Use be + adjective to describe a device."
            },
            {
              "english": "I use this app every day.",
              "spanish": "Present simple",
              "note": "Use the present simple for habits."
            }
          ],
          "reading": [
            {
              "english": "Read a short message exchange and identify what each person is doing and which device they use.",
              "spanish": "Lee un breve intercambio de mensajes e identifica qué hace cada persona y qué dispositivo utiliza."
            }
          ],
          "writing": [
            {
              "english": "Write a short message explaining a phone problem and asking a friend for help.",
              "spanish": "Escribe un mensaje breve explicando un problema con el móvil y pidiendo ayuda."
            }
          ],
          "speaking": [
            {
              "english": "Explain how you use an app and ask someone to send you a file.",
              "spanish": "Explica cómo utilizas una aplicación y pide a alguien que te envíe un archivo."
            }
          ],
          "listening": [
            {
              "english": "Listen to two friends discussing a video call, a photo and a phone battery.",
              "spanish": "Escucha a dos amigos hablar de una videollamada, una foto y la batería de un móvil."
            }
          ]
        }
      }
    },
