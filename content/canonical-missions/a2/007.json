        "theory": {
          "title": "Rooms, home descriptions and household chores",
          "explanation": "Use there is with one thing and there are with more than one: There is a balcony; there are two bedrooms. Use some in positive sentences and any in most questions and negatives. Describe a room with adjectives such as tidy, messy, comfortable and clean. Use the present simple to talk about chores and how often you do them. Use have to to talk about responsibilities: I have to wash the dishes.",
          "tip": "Say do the laundry and do the shopping, but make the bed. Use have to + base verb.",
          "patterns": [
            {
              "label": "Block 1 · Rooms",
              "pattern": "There is a + singular room/feature",
              "examples": [
                "There is a small kitchen.",
                "There is a balcony."
              ]
            },
            {
              "label": "Block 2 · More than one",
              "pattern": "There are + plural noun",
              "examples": [
                "There are two bedrooms.",
                "There are three windows."
              ]
            },
            {
              "label": "Block 3 · Some and any",
              "pattern": "There is some; Is there any ...?",
              "examples": [
                "There is some furniture.",
                "Are there any plants?"
              ]
            },
            {
              "label": "Block 4 · Describing a home",
              "pattern": "be + adjective",
              "examples": [
                "The living room is comfortable.",
                "My bedroom is tidy."
              ]
            },
            {
              "label": "Block 5 · Location",
              "pattern": "upstairs; downstairs; next to",
              "examples": [
                "The bedrooms are upstairs.",
                "The kitchen is next to the hall."
              ]
            },
            {
              "label": "Block 6 · Chores",
              "pattern": "do the laundry; wash the dishes; make the bed",
              "examples": [
                "I do the laundry on Saturday.",
                "He makes the bed every morning."
              ]
            },
            {
              "label": "Block 7 · Frequency",
              "pattern": "once/twice a week; every day",
              "examples": [
                "We vacuum once a week.",
                "She waters the plants every day."
              ]
            },
            {
              "label": "Block 8 · Have to",
              "pattern": "subject + have/has to + base verb",
              "examples": [
                "I have to clean my room.",
                "He has to feed the dog."
              ]
            },
            {
              "label": "Block 9 · Don't have to",
              "pattern": "subject + don't/doesn't have to + base verb",
              "examples": [
                "We don't have to work today.",
                "She doesn't have to cook tonight."
              ]
            },
            {
              "label": "Block 10 · Sharing chores",
              "pattern": "Who does ...?; I usually ...; We share ...",
              "examples": [
                "Who takes out the rubbish?",
                "We share the housework."
              ]
            }
          ]
        },
        "lesson": {
          "phrases": [
            {
              "english": "There are two bedrooms in my flat.",
              "spanish": "Hay dos dormitorios en mi piso."
            },
            {
              "english": "The kitchen is downstairs.",
              "spanish": "La cocina está abajo."
            },
            {
              "english": "My bedroom is small but comfortable.",
              "spanish": "Mi dormitorio es pequeño pero cómodo."
            },
            {
              "english": "Are there any plants in the living room?",
              "spanish": "¿Hay plantas en el salón?"
            },
            {
              "english": "I have to wash the dishes after dinner.",
              "spanish": "Tengo que lavar los platos después de cenar."
            },
            {
              "english": "We do the laundry twice a week.",
              "spanish": "Hacemos la colada dos veces por semana."
            },
            {
              "english": "Who takes out the rubbish?",
              "spanish": "¿Quién saca la basura?"
            },
            {
              "english": "My brother and I share the housework.",
              "spanish": "Mi hermano y yo compartimos las tareas domésticas."
            }
          ],
          "grammar": [
            {
              "english": "There is a bathroom upstairs.",
              "spanish": "Hay un baño arriba.",
              "note": "There is con singular."
            },
            {
              "english": "There are three rooms downstairs.",
              "spanish": "Hay tres habitaciones abajo.",
              "note": "There are con plural."
            },
            {
              "english": "There isn't a garden.",
              "spanish": "No hay jardín.",
              "note": "Negativa en singular."
            },
            {
              "english": "Are there any windows?",
              "spanish": "¿Hay ventanas?",
              "note": "Any en preguntas."
            },
            {
              "english": "There are some plants on the balcony.",
              "spanish": "Hay algunas plantas en el balcón.",
              "note": "Some en afirmativas."
            },
            {
              "english": "I have to clean my room.",
              "spanish": "Tengo que limpiar mi habitación.",
              "note": "Have to expresa obligación."
            },
            {
              "english": "She has to feed the dog.",
              "spanish": "Ella tiene que dar de comer al perro.",
              "note": "Has to con she."
            },
            {
              "english": "We don't have to cook today.",
              "spanish": "No tenemos que cocinar hoy.",
              "note": "Don't have to expresa ausencia de obligación."
            },
            {
              "english": "He doesn't have to do the shopping.",
              "spanish": "Él no tiene que hacer la compra.",
              "note": "Doesn't have to con he."
            },
            {
              "english": "I vacuum the floor once a week.",
              "spanish": "Paso la aspiradora una vez por semana.",
              "note": "Frecuencia al final de la frase."
            }
          ],
          "reading": [
            {
              "english": "Read a description of a shared flat and its chores.",
              "spanish": "Lee la descripción de un piso compartido y sus tareas domésticas."
            }
          ],
          "writing": [
            {
              "english": "Listen and write sentences about rooms and chores.",
              "spanish": "Escucha y escribe frases sobre habitaciones y tareas."
            }
          ],
          "speaking": [
            {
              "english": "Describe your home and explain how you share chores.",
              "spanish": "Describe tu casa y explica cómo repartís las tareas."
            }
          ],
          "listening": [
            {
              "english": "Listen for rooms, household objects and responsibilities.",
              "spanish": "Escucha habitaciones, objetos y responsabilidades."
            }
          ]
        }
      }
