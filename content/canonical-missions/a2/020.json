        "theory": {
          "title": "Talking about work and jobs",
          "explanation": "Use the present simple to describe job routines and responsibilities. Use can/can't to talk about skills. Use have to/don't have to for work rules and things that are not necessary. Use adverbs of frequency to say how often you do tasks. Use the present continuous for temporary activities happening now.",
          "tip": "Remember: he/she/it takes -s in the present simple. After can and have to, use the base form of the verb.",
          "patterns": [
            {
              "label": "Block 1 · Say what you do",
              "pattern": "I work as a/an + job",
              "examples": [
                "I work as a receptionist.",
                "She works as a nurse."
              ]
            },
            {
              "label": "Block 2 · Describe routines",
              "pattern": "subject + present simple",
              "examples": [
                "He answers emails every morning.",
                "They prepare food for customers."
              ]
            },
            {
              "label": "Block 3 · Ask about someone's job",
              "pattern": "What do/does + subject + do?",
              "examples": [
                "What do you do?",
                "What does your manager do?"
              ]
            },
            {
              "label": "Block 4 · Talk about skills",
              "pattern": "subject + can/can't + base verb",
              "examples": [
                "I can use a computer.",
                "He can't speak French."
              ]
            },
            {
              "label": "Block 5 · Work responsibilities",
              "pattern": "subject + have to + base verb",
              "examples": [
                "I have to wear a uniform.",
                "She has to start at eight."
              ]
            },
            {
              "label": "Block 6 · No obligation",
              "pattern": "subject + don't/doesn't have to + base verb",
              "examples": [
                "We don't have to work on Sundays.",
                "He doesn't have to attend the meeting."
              ]
            },
            {
              "label": "Block 7 · Frequency at work",
              "pattern": "subject + adverb of frequency + verb",
              "examples": [
                "I usually have lunch at one.",
                "She never arrives late."
              ]
            },
            {
              "label": "Block 8 · Actions happening now",
              "pattern": "am/is/are + verb-ing",
              "examples": [
                "I'm helping a customer now.",
                "They are having a meeting."
              ]
            },
            {
              "label": "Block 9 · Talk about working hours",
              "pattern": "I start/finish work at + time",
              "examples": [
                "I start work at half past eight.",
                "He finishes at five."
              ]
            },
            {
              "label": "Block 10 · Ask about a job",
              "pattern": "Is the job full-time or part-time?",
              "examples": [
                "Is this job full-time?",
                "Do you have any experience?"
              ]
            }
          ]
        },
        "lesson": {
          "phrases": [
            {
              "english": "I work as a shop assistant.",
              "spanish": "Trabajo como dependiente/a."
            },
            {
              "english": "What time do you start work?",
              "spanish": "¿A qué hora empiezas a trabajar?"
            },
            {
              "english": "I usually have a short break at eleven.",
              "spanish": "Normalmente hago un breve descanso a las once."
            },
            {
              "english": "She is helping a customer at the moment.",
              "spanish": "Ella está ayudando a un cliente en este momento."
            },
            {
              "english": "Do you work full-time or part-time?",
              "spanish": "¿Trabajas a jornada completa o parcial?"
            },
            {
              "english": "I have to wear a uniform at work.",
              "spanish": "Tengo que llevar uniforme en el trabajo."
            },
            {
              "english": "Can you use this computer programme?",
              "spanish": "¿Sabes utilizar este programa informático?"
            },
            {
              "english": "We have a team meeting every Monday.",
              "spanish": "Tenemos una reunión de equipo todos los lunes."
            }
          ],
          "grammar": [
            {
              "english": "I work in a small office.",
              "spanish": "Present simple",
              "note": "Use the present simple for regular work routines."
            },
            {
              "english": "My colleague answers the phone.",
              "spanish": "Third-person -s",
              "note": "Add -s to most verbs with he, she and it."
            },
            {
              "english": "What does your manager do?",
              "spanish": "Questions with does",
              "note": "Use does + subject + base verb."
            },
            {
              "english": "I can organise the files.",
              "spanish": "Can for skills",
              "note": "Can is followed by the base form of the verb."
            },
            {
              "english": "He has to wear a uniform.",
              "spanish": "Have to",
              "note": "Use has to with he, she and it."
            },
            {
              "english": "We don't have to work on Saturday.",
              "spanish": "Don't have to",
              "note": "It means something is not necessary."
            },
            {
              "english": "She usually starts at nine.",
              "spanish": "Adverbs of frequency",
              "note": "Frequency adverbs usually go before the main verb."
            },
            {
              "english": "I'm speaking to a customer now.",
              "spanish": "Present continuous",
              "note": "Use am/is/are + -ing for an action happening now."
            },
            {
              "english": "Do you have any experience?",
              "spanish": "Questions with do",
              "note": "Use do + subject + base verb."
            },
            {
              "english": "They finish work at half past five.",
              "spanish": "Work schedules",
              "note": "Use the present simple for regular schedules."
            }
          ],
          "reading": [
            {
              "english": "Read a short staff profile and identify job duties, working hours and workplace rules.",
              "spanish": "Lee el perfil de un empleado e identifica sus tareas, horario y normas laborales."
            }
          ],
          "writing": [
            {
              "english": "Write a short profile describing your job, skills and a typical working day.",
              "spanish": "Escribe un perfil breve describiendo tu trabajo, habilidades y un día habitual."
            }
          ],
          "speaking": [
            {
              "english": "Talk about a job you know and describe its daily tasks and working hours.",
              "spanish": "Habla de un trabajo que conozcas y describe sus tareas diarias y horario."
            }
          ],
          "listening": [
            {
              "english": "Listen to a new employee talking about her job, colleagues and daily routine.",
              "spanish": "Escucha a una nueva empleada hablar de su trabajo, compañeros y rutina diaria."
            }
          ]
        }
      }
    },
