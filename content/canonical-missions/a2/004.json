        "theory": {
          "title": "Free-time activities and preferences",
          "explanation": "Habla de tus aficiones y del tiempo libre. Después de like, love, enjoy, don't mind y hate, puedes usar un verbo terminado en -ing: I enjoy reading. Para preguntar por gustos, usa What do you like doing? y responde con I like ... Para proponer un plan, usa Let's + verbo base o Why don't we + verbo base? Para aceptar, puedes decir That sounds great; para rechazar con educación, I'm afraid I can't.",
          "tip": "No uses to después de enjoy: enjoy swimming. Con like, love y hate es frecuente usar -ing para hablar de actividades en general. Let's va seguido del verbo base, sin to.",
          "patterns": [
            {
              "label": "Bloque 1 · Free-time nouns",
              "pattern": "hobby; free time; activity",
              "examples": [
                "My favourite hobby is drawing.",
                "What do you do in your free time?"
              ]
            },
            {
              "label": "Bloque 2 · Sports and exercise",
              "pattern": "go cycling; go swimming; go to the gym",
              "examples": [
                "I go cycling at weekends.",
                "She goes swimming on Fridays."
              ]
            },
            {
              "label": "Bloque 3 · Games and music",
              "pattern": "play board games; play an instrument",
              "examples": [
                "We play board games together.",
                "He plays the guitar."
              ]
            },
            {
              "label": "Bloque 4 · Creative activities",
              "pattern": "draw; paint; take photos",
              "examples": [
                "I enjoy taking photos.",
                "My sister loves painting."
              ]
            },
            {
              "label": "Bloque 5 · Social activities",
              "pattern": "meet friends; hang out; go for a walk",
              "examples": [
                "I often meet my friends after school.",
                "We hang out in the park."
              ]
            },
            {
              "label": "Bloque 6 · Like + -ing",
              "pattern": "like/love/enjoy/don't mind/hate + verb-ing",
              "examples": [
                "I enjoy reading comics.",
                "They don't mind cooking."
              ]
            },
            {
              "label": "Bloque 7 · Questions about preferences",
              "pattern": "What do you like doing?; Do you enjoy ...?",
              "examples": [
                "What do you like doing at weekends?",
                "Do you enjoy dancing?"
              ]
            },
            {
              "label": "Bloque 8 · Preference contrasts",
              "pattern": "prefer A to B",
              "examples": [
                "I prefer cycling to running.",
                "She prefers films to video games."
              ]
            },
            {
              "label": "Bloque 9 · Making suggestions",
              "pattern": "Let's + base verb; Why don't we + base verb?",
              "examples": [
                "Let's watch a film.",
                "Why don't we go swimming?"
              ]
            },
            {
              "label": "Bloque 10 · Accepting and refusing",
              "pattern": "That sounds great; I'd love to; I'm afraid I can't",
              "examples": [
                "That sounds great!",
                "I'd love to, but I'm busy."
              ]
            }
          ]
        },
        "lesson": {
          "phrases": [
            {
              "english": "What do you like doing in your free time?",
              "spanish": "¿Qué te gusta hacer en tu tiempo libre?"
            },
            {
              "english": "I enjoy listening to music and reading comics.",
              "spanish": "Disfruto escuchando música y leyendo cómics."
            },
            {
              "english": "My favourite hobby is taking photos.",
              "spanish": "Mi pasatiempo favorito es hacer fotos."
            },
            {
              "english": "I prefer cycling to running.",
              "spanish": "Prefiero ir en bicicleta a correr."
            },
            {
              "english": "Would you like to go swimming on Saturday?",
              "spanish": "¿Te gustaría ir a nadar el sábado?"
            },
            {
              "english": "That sounds great! What time?",
              "spanish": "¡Suena genial! ¿A qué hora?"
            },
            {
              "english": "Why don't we meet at the park?",
              "spanish": "¿Por qué no quedamos en el parque?"
            },
            {
              "english": "I'm afraid I can't. I'm visiting my grandparents.",
              "spanish": "Me temo que no puedo. Voy a visitar a mis abuelos."
            }
          ],
          "grammar": [
            {
              "english": "I enjoy playing board games.",
              "spanish": "Disfruto jugando a juegos de mesa.",
              "note": "enjoy + verbo terminado en -ing."
            },
            {
              "english": "She loves dancing.",
              "spanish": "A ella le encanta bailar.",
              "note": "love + -ing para gustos."
            },
            {
              "english": "We don't mind walking.",
              "spanish": "No nos importa caminar.",
              "note": "don't mind + -ing."
            },
            {
              "english": "He hates getting up early.",
              "spanish": "Odia levantarse temprano.",
              "note": "hate + -ing."
            },
            {
              "english": "What do you like doing?",
              "spanish": "¿Qué te gusta hacer?",
              "note": "like + -ing en preguntas de preferencias."
            },
            {
              "english": "I prefer swimming to cycling.",
              "spanish": "Prefiero nadar a ir en bicicleta.",
              "note": "prefer A to B."
            },
            {
              "english": "Let's take some photos.",
              "spanish": "Hagamos unas fotos.",
              "note": "Let's + verbo base."
            },
            {
              "english": "Why don't we watch a film?",
              "spanish": "¿Por qué no vemos una película?",
              "note": "Why don't we + verbo base."
            },
            {
              "english": "Would you like to come with us?",
              "spanish": "¿Te gustaría venir con nosotros?",
              "note": "Would you like to + infinitivo para invitar."
            },
            {
              "english": "I'd love to, but I'm busy.",
              "spanish": "Me encantaría, pero estoy ocupado/a.",
              "note": "Respuesta amable a una invitación."
            }
          ],
          "reading": [
            {
              "english": "Read about three friends and their favourite free-time activities.",
              "spanish": "Lee sobre tres amigos y sus actividades favoritas."
            },
            {
              "english": "Find examples of like, enjoy and prefer followed by -ing or a noun.",
              "spanish": "Encuentra ejemplos de like, enjoy y prefer seguidos de -ing o de un sustantivo."
            }
          ],
          "writing": [
            {
              "english": "Listen and write short sentences about hobbies and plans.",
              "spanish": "Escucha y escribe frases cortas sobre aficiones y planes."
            },
            {
              "english": "Check the -ing form after enjoy, love and hate.",
              "spanish": "Comprueba la forma -ing después de enjoy, love y hate."
            }
          ],
          "speaking": [
            {
              "english": "Talk about your hobbies and invite a friend to do an activity.",
              "spanish": "Habla de tus aficiones e invita a un amigo a hacer una actividad."
            },
            {
              "english": "Accept or refuse an invitation politely.",
              "spanish": "Acepta o rechaza una invitación con educación."
            }
          ],
          "listening": [
            {
              "english": "Listen for activities, preferences and invitations.",
              "spanish": "Escucha actividades, preferencias e invitaciones."
            },
            {
              "english": "Identify how the speakers accept or refuse plans.",
              "spanish": "Identifica cómo aceptan o rechazan los planes los hablantes."
            }
          ]
        }
      }
    },
